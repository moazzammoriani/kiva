---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageSection from "../components/PageSection.astro";
import FramedImage from "../components/FramedImage.astro";
import SectionBreakLeaf from "../components/SectionBreakLeaf.astro";
import { richTextToHtml } from "../utils/richTextToHtml";

const entries = await getCollection("community");
const data = entries[0]?.data;

const heroSrc = data?.heroImage ?? "/images/community/Banner_SeniorSchool.png";
const events = data?.events ?? [];
---

<BaseLayout pageTitle={null} heroSrc={heroSrc}>
  <PageSection
    title={data?.introTitle ?? "PARENT ENGAGEMENT"}
    headingLevel={2}
    contentWidth="narrow"
  >
    <div class="stack-lg" set:html={richTextToHtml(data?.introText) || ""} />
  </PageSection>

  {events.map((event, i) => (
    <>
      <PageSection
        title={event.title ?? ""}
        headingLevel={2}
        contentWidth="narrow"
      >
        <FramedImage imgSrc={event.image ?? ""} />
        <div class="stack-lg" set:html={richTextToHtml(event.description) || ""} />
      </PageSection>
      {i < events.length - 1 && <SectionBreakLeaf />}
    </>
  ))}
</BaseLayout>
