---
import BaseLayout from "../../layouts/BaseLayout.astro";
import heroImage from "../../assets/Banner_KivaSquare2024.png";
import PageSection from "../../components/PageSection.astro";
---

<BaseLayout pageTitle={null} heroSrc={heroImage.src}>
  <PageSection title="Middle & Senior School" headingLevel={1}>
    <div class="stack-lg">
      <p>
        Launched in 2021, Kiva School came into being after Muzaffar Bukhari of
        Veritas Learning Circle joined EWPL as a new partner. Bringing a fresh
        perspective and vision to the organisation, Kiva School was established
        as a new chapter of the AMI pre-school focusing on early developmental
        years from a place of curiosity and exploration.
      </p>
      <p>
        Breaking away from conventional teaching methods and adopting the
        Finnish play-based educational philosophy, Kiva embodies values of
        kindness and social responsibility that encourage personal growth at
        each child’s own pace.
      </p>
    </div>
  </PageSection>
</BaseLayout>
