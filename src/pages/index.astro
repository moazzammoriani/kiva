---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageSection from "../components/PageSection.astro";
import IntroBlock from "../components/IntroBlock.astro";
import SimpleSlideshow from "../components/SimpleSlideshow.astro";
import LogosSlideShow from "../components/LogosSlideShow.astro";
import { richTextToHtml } from "../utils/richTextToHtml";

const homeEntries = await getCollection("home");
const home = homeEntries[0]?.data;

const slideshowImages = (home?.slideshowImages ?? []).map((img) => ({
    src: img?.src ?? "",
    alt: img?.alt ?? "",
    label: img?.label ?? "",
}));

const educationWorksLogos = (home?.educationWorksLogos ?? []).map((logo) => ({
    src: logo?.src ?? "",
    alt: logo?.alt ?? "",
}));

const partnerLogos = (home?.partnerLogos ?? []).map((logo) => ({
    src: logo?.src ?? "",
    alt: logo?.alt ?? "",
}));
---

<BaseLayout pageTitle={null} heroSrc={home?.heroImage ?? ""}>
    <!-- TODO: decrease the spacing between the letters -->
    <!-- TODO: make the font weight 1000-->
    <PageSection>
        <picture>
            <source srcset={(home?.birdHouseImage ?? "").replace(/\.(png|jpe?g)$/i, ".webp")} type="image/webp" />
            <img id="birdhouse" src={home?.birdHouseImage ?? ""} alt="" />
        </picture>
        <IntroBlock
            icon=""
            heading={home?.welcomeHeading ?? ""}
            tagline={home?.welcomeTagline ?? ""}
        >
            <Fragment set:html={richTextToHtml(home?.welcomeBody)} />
        </IntroBlock>
    </PageSection>

    <PageSection title={home?.spacesTitle ?? "OUR SPACES"} headingLevel={3}>
        <SimpleSlideshow images={slideshowImages} />
    </PageSection>

    <PageSection title={home?.educationWorksTitle ?? "EDUCATION WORKS PVT. LTD."} headingLevel={3}>
        <LogosSlideShow
            logos={educationWorksLogos}
            speedMs={23000}
            height={90}
        />
    </PageSection>
    <PageSection title={home?.partnersTitle ?? "PARTNERS AND COLLABORATORS"} headingLevel={3}>
        <LogosSlideShow
            logos={partnerLogos}
            speedMs={23000}
            height={90}
        />
    </PageSection>
</BaseLayout>

<style>
    #birdhouse {
        width: 300px;
    }
</style>
