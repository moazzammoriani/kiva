---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout pageTitle={null}>
  <section class="intro section" aria-labelledby="welcome-heading">
    <div class="intro-icon" aria-hidden="true">🏡</div>
    <h1 id="welcome-heading" class="intro-heading">WELCOME TO KIVA</h1>
    <p class="intro-tagline">A place we call home</p>
    <div class="intro-copy">
      <p>
        Launched in 2021, Kiva School came into being after Muzaffar Bukhari of Veritas
        Learning Circle joined EWPL as a new partner. Bringing a fresh perspective and vision to the
        organisation, Kiva School was established as a new chapter of the AMI pre-school focusing on
        early developmental years from a place of curiosity and exploration.
      </p>
      <p>
        Breaking away from conventional teaching methods and adopting the Finnish play-based
        educational philosophy, Kiva embodies values of kindness and social responsibility that
        encourage personal growth at each child’s own pace.
      </p>
    </div>
  </section>

  <section class="spaces section" aria-labelledby="spaces-heading">
    <h2 id="spaces-heading" class="section-heading">OUR SPACES</h2>
    <div class="space-placeholder" role="img" aria-label="Library space placeholder"></div>
    <p class="space-caption">Library</p>
  </section>

  <section class="partners section" aria-labelledby="partners-heading">
    <h2 id="partners-heading" class="section-heading">PARTNERS &amp; COLLABORATORS</h2>
    <div class="partners-logos">
      {[
        "The AMI School",
        "AMI Daycare",
        "Paary",
        "Kiran Foundation",
        "Teddy Tennis",
        "CCS",
        "AHC STEM Club",
      ].map((name) => (
        <div class="logo-placeholder" role="img" aria-label={`${name} logo placeholder`}>
          {name}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  :root {
    --teal: #0db29b;
    --deep-teal: #05897a;
    --warm-yellow: #f6c65b;
    --text-primary: #214244;
    --text-muted: #5f7576;
  }

  .section {
    padding: 3rem 1.5rem;
    text-align: center;
  }

  .intro {
    padding-top: 2rem;
  }
  .intro-icon {
    font-size: 2.4rem;
    color: var(--teal);
    margin-bottom: 0.5rem;
  }
  .intro-heading {
    font-size: clamp(2.1rem, 3vw + 1rem, 3rem);
    line-height: 1.1;
    margin: 0.5rem 0 0;
    letter-spacing: 1.5px;
    color: var(--teal);
  }
  .intro-tagline {
    font-size: 1.15rem;
    color: var(--deep-teal);
    margin: 0.5rem 0 1.2rem;
  }
  .intro-copy {
    max-width: 68ch;
    margin: 0 auto;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
  }
  .intro-copy p {
    margin: 0 0 1rem;
  }

  .section-heading {
    font-size: clamp(1.6rem, 2vw + 1rem, 2.3rem);
    color: var(--teal);
    letter-spacing: 1.5px;
    margin-bottom: 1.5rem;
  }

  .space-placeholder {
    background: var(--warm-yellow);
    border-radius: 16px;
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    min-height: clamp(220px, 40vw, 420px);
  }
  .space-caption {
    margin-top: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .partners-logos {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }
  .logo-placeholder {
    background: var(--warm-yellow);
    border-radius: 12px;
    padding: 1rem;
    min-width: 140px;
    min-height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--deep-teal);
    font-weight: 600;
    text-align: center;
  }

  @media (max-width: 600px) {
    .section {
      padding: 2.5rem 1rem;
    }
    .logo-placeholder {
      min-width: 120px;
      min-height: 60px;
      font-size: 0.85rem;
    }
  }
</style>
