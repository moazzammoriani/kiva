---
import BaseLayout from "../layouts/BaseLayout.astro";
import heroImage from "../assets/high-angle-child-woman-painting.jpg";
import PageSection from "../components/PageSection.astro";
import IntroBlock from "../components/IntroBlock.astro";
---

<BaseLayout pageTitle={null} heroSrc={heroImage.src}>
  <PageSection>
    <IntroBlock icon="🏡" heading="Welcome to Kiva" tagline="A place we call home">
      <p>
        Launched in 2021, Kiva School came into being after Muzaffar Bukhari of Veritas Learning
        Circle joined EWPL as a new partner. Bringing a fresh perspective and vision to the
        organisation, Kiva School was established as a new chapter of the AMI pre-school focusing on
        early developmental years from a place of curiosity and exploration.
      </p>
      <p>
        Breaking away from conventional teaching methods and adopting the Finnish play-based
        educational philosophy, Kiva embodies values of kindness and social responsibility that
        encourage personal growth at each child’s own pace.
      </p>
    </IntroBlock>
  </PageSection>

  <PageSection title="Our Spaces">
    <div class="placeholder-card placeholder-card--xl" role="img" aria-label="Library space placeholder"></div>
    <p class="section-caption">Library</p>
  </PageSection>

  <PageSection title="Partners & Collaborators">
    <div class="grid-responsive">
      {[
        "The AMI School",
        "AMI Daycare",
        "Paary",
        "Kiran Foundation",
        "Teddy Tennis",
        "CCS",
        "AHC STEM Club",
      ].map((name) => (
        <div class="placeholder-logo" role="img" aria-label={`${name} logo placeholder`}>
          {name}
        </div>
      ))}
    </div>
  </PageSection>
</BaseLayout>
