---
import BaseLayout from "../layouts/BaseLayout.astro";
import heroImage from "../assets/Banner_Career.png";
import PageSection from "../components/PageSection.astro";
---

<BaseLayout pageTitle={null} heroSrc={heroImage.src}>
    <PageSection>
        <p class="careers-intro">
            <strong
                >If you feel like you resonate with our values and aren’t afraid
                to connect with your inner child,
            </strong>
            join the flock!
        </p>
    </PageSection>

    <PageSection align="left">
        <form class="careers-form">
            <div class="form-grid">
                <label class="form-field">
                    <input type="text" name="name" placeholder=" " required />
                    <span>Full Name</span>
                </label>
                <label class="form-field">
                    <input type="email" name="email" placeholder=" " required />
                    <span>Email Address</span>
                </label>
                <label class="form-field">
                    <input type="tel" name="phone" placeholder=" " />
                    <span>Contact Number</span>
                </label>
                <label class="form-field">
                    <input type="text" name="position" placeholder=" " />
                    <span>Position of Interest</span>
                </label>
            </div>

            <label class="form-field form-field--textarea">
                <textarea name="coverLetter" rows={6} placeholder=" "></textarea>
                <span>Cover Letter (300 words)</span>
            </label>

            <div class="upload-row">
                <label class="upload-button">
                    <span>Upload CV</span>
                    <input type="file" name="cv" accept=".pdf,.doc,.docx" />
                </label>
            </div>

            <div class="form-actions">
                <button type="submit" class="submit-button">Submit</button>
            </div>
        </form>
    </PageSection>
</BaseLayout>

<style>
    .careers-intro {
        max-width: 60ch;
        margin: 0 auto;
        font-size: 28px;
        font-weight: 900;
        color: var(--color-text-primary);
        text-align: center;
    }

    .careers-intro strong {
        display: block;
        color: var(--color-teal);
        margin-bottom: 0.4rem;
    }

    .leaf-divider {
        font-size: 1.8rem;
        text-align: center;
        color: var(--color-teal);
    }

    .careers-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .form-field {
        position: relative;
        display: flex;
        flex-direction: column;
    }

    .form-field span {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        font-weight: 500;
        color: white;
        pointer-events: none;
        transition: all 0.2s ease;
        background: transparent;
    }

    .form-field input,
    .form-field textarea {
        border: none;
        border-radius: 18px;
        padding: 1.4rem 1rem 0.6rem;
        background: var(--color-purple);
        color: var(--color-text-inverse);
        font-size: 1rem;
    }

    /* Floating label state - focused or has content */
    .form-field input:focus + span,
    .form-field input:not(:placeholder-shown) + span {
        top: 0.5rem;
        transform: translateY(0);
        font-size: 0.6rem;
    }

    /* Textarea specific adjustments */
    .form-field--textarea span {
        top: 1.2rem;
        transform: translateY(0);
    }

    .form-field textarea:focus + span,
    .form-field textarea:not(:placeholder-shown) + span {
        top: 0.4rem;
        font-size: 0.6rem;
    }

    .form-field textarea {
        resize: vertical;
        padding-top: 1.6rem;
    }

    .upload-row {
        display: flex;
        justify-content: center;
    }

    .upload-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: var(--color-violet);
        color: var(--color-text-inverse);
        border-radius: 999px;
        padding: 0.75rem 2rem;
        cursor: pointer;
        font-weight: 900;
    }

    .upload-button input[type="file"] {
        display: none;
    }

    .form-actions {
        display: flex;
        justify-content: center;
    }

    .submit-button {
        border: none;
        border-radius: 999px;
        font-weight: 900;
        padding: 0.85rem 2.75rem;
        background: #032c47;
        color: var(--color-text-inverse);
        font-size: 1rem;
        cursor: pointer;
    }

    .submit-button:hover {
        background: #05456d;
    }

    @media (max-width: 720px) {
        .careers-intro {
            font-size: 1.05rem;
        }
    }
</style>
