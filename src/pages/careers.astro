---
import BaseLayout from "../layouts/BaseLayout.astro";
import heroImage from "../assets/Banner_Career.png";
import PageSection from "../components/PageSection.astro";
import FormNotification from "../components/FormNotification.astro";
---

<BaseLayout pageTitle={null} heroSrc={heroImage.src}>
    <PageSection>
        <p class="careers-intro">
            <strong
                >If you feel like you resonate with our values and aren’t afraid
                to connect with your inner child,
            </strong>
            join the flock!
        </p>
    </PageSection>

    <PageSection align="left">
        <form class="careers-form" id="careers-form">
            <div class="form-grid">
                <label class="form-field">
                    <input type="text" name="name" placeholder=" " required />
                    <span>Full Name</span>
                </label>
                <label class="form-field">
                    <input type="email" name="email" placeholder=" " required />
                    <span>Email Address</span>
                </label>
                <label class="form-field">
                    <input type="tel" name="phone" placeholder=" " />
                    <span>Contact Number</span>
                </label>
                <label class="form-field">
                    <input type="text" name="position" placeholder=" " />
                    <span>Position of Interest</span>
                </label>
            </div>

            <label class="form-field form-field--textarea">
                <textarea name="coverLetter" rows={6} placeholder=" "></textarea>
                <span>Cover Letter (300 words)</span>
            </label>

            <div class="upload-row">
                <div class="file-upload-wrapper" id="cv-upload-wrapper">
                    <label class="upload-button">
                        <span>Upload CV</span>
                        <input type="file" name="cv" accept=".pdf,.doc,.docx" />
                    </label>
                    <div class="file-info" style="display: none;">
                        <span class="file-name"></span>
                        <button type="button" class="remove-file-button">Remove</button>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="submit-button">Submit</button>
            </div>
        </form>
        <FormNotification
            id="careers-success"
            title="Application Submitted"
            message="Thank you for your interest! We will review your application and get back to you."
        />
    </PageSection>
</BaseLayout>

<style>
    .careers-intro {
        max-width: 60ch;
        margin: 0 auto;
        font-size: 28px;
        font-weight: 900;
        color: var(--color-text-primary);
        text-align: center;
    }

    .careers-intro strong {
        display: block;
        color: var(--color-teal);
        margin-bottom: 0.4rem;
    }

    .leaf-divider {
        font-size: 1.8rem;
        text-align: center;
        color: var(--color-teal);
    }

    .careers-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .form-field {
        position: relative;
        display: flex;
        flex-direction: column;
    }

    .form-field span {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        font-weight: 500;
        color: rgba(255, 255, 255, 0.7);
        pointer-events: none;
        transition: all 0.2s ease;
        background: transparent;
    }

    .form-field input,
    .form-field textarea {
        border: none;
        border-radius: 18px;
        padding: 1.4rem 1rem 0.6rem;
        background: #d59bed;
        color: var(--color-text-inverse);
        font-size: 1rem;
    }

    /* Floating label state - focused or has content */
    .form-field input:focus + span,
    .form-field input:not(:placeholder-shown) + span {
        top: 0.5rem;
        transform: translateY(0);
        font-size: 0.6rem;
    }

    /* Textarea specific adjustments */
    .form-field--textarea span {
        top: 1.2rem;
        transform: translateY(0);
    }

    .form-field textarea:focus + span,
    .form-field textarea:not(:placeholder-shown) + span {
        top: 0.4rem;
        font-size: 0.6rem;
        color: white;
    }

    .form-field textarea {
        resize: vertical;
        padding-top: 1.6rem;
    }

    .upload-row {
        display: flex;
        justify-content: center;
    }

    .upload-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: var(--color-violet);
        color: var(--color-text-inverse);
        border-radius: 999px;
        padding: 0.75rem 2rem;
        cursor: pointer;
        font-weight: 900;
    }

    .upload-button input[type="file"] {
        display: none;
    }

    .file-upload-wrapper {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
    }

    .file-info {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 1rem;
        background: var(--color-violet);
        border-radius: var(--radius-md);
        font-size: 0.9rem;
    }

    .file-name {
        color: var(--color-text-inverse);
        word-break: break-all;
    }

    .remove-file-button {
        background: none;
        border: none;
        color: var(--color-warm-yellow);
        cursor: pointer;
        font-weight: 600;
        padding: 0.25rem 0.5rem;
        font-family: inherit;
    }

    .remove-file-button:hover {
        text-decoration: underline;
    }

    .form-actions {
        display: flex;
        justify-content: center;
    }

    .submit-button {
        border: none;
        border-radius: 999px;
        font-weight: 900;
        padding: 0.85rem 2.75rem;
        background: #032c47;
        color: var(--color-text-inverse);
        font-size: 1rem;
        cursor: pointer;
    }

    .submit-button:hover {
        background: #05456d;
    }

    @media (max-width: 720px) {
        .careers-intro {
            font-size: 1.05rem;
        }
    }
</style>

<script>
    const form = document.getElementById('careers-form') as HTMLFormElement;
    const notification = document.getElementById('careers-success');

    // File upload handling
    const fileInput = document.querySelector('input[name="cv"]') as HTMLInputElement;
    const uploadWrapper = document.getElementById('cv-upload-wrapper');
    const uploadButton = uploadWrapper?.querySelector('.upload-button') as HTMLElement;
    const fileInfo = uploadWrapper?.querySelector('.file-info') as HTMLElement;
    const fileName = uploadWrapper?.querySelector('.file-name') as HTMLElement;
    const removeButton = uploadWrapper?.querySelector('.remove-file-button');

    fileInput?.addEventListener('change', () => {
        if (fileInput.files && fileInput.files.length > 0) {
            fileName.textContent = fileInput.files[0].name;
            uploadButton.style.display = 'none';
            fileInfo.style.display = 'inline-flex';
        }
    });

    removeButton?.addEventListener('click', () => {
        fileInput.value = '';
        uploadButton.style.display = 'inline-flex';
        fileInfo.style.display = 'none';
    });

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        try {
            const response = await fetch('/api/careers', {
                method: 'POST',
                body: formData,
            });
            if (response.ok) {
                form.style.display = 'none';
                if (notification) notification.style.display = 'flex';
            } else {
                alert('Something went wrong. Please try again.');
            }
        } catch (error) {
            alert('Something went wrong. Please try again.');
        }
    });
</script>
