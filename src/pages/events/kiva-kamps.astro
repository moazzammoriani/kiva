---
import { readdirSync } from "node:fs";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageSection from "../../components/PageSection.astro";
import FormNotification from "../../components/FormNotification.astro";
import HeroSlideshow from "../../components/HeroSlideshow.astro";
import { richTextToHtml } from "../../utils/richTextToHtml";

const bannerSlidesDir = new URL("../../../public/images/kiva-kamps/form/", import.meta.url);

const fallbackBannerSlides = readdirSync(bannerSlidesDir)
  .filter((fileName) => fileName.endsWith(".webp"))
  .sort((leftPath, rightPath) =>
    leftPath.localeCompare(rightPath, undefined, { numeric: true })
  )
  .map((fileName) => ({
    src: `/images/kiva-kamps/form/${fileName}`,
    alt: "",
  }));

const fallbackCardGroups = [
  {
    variant: "details",
    items: [
      { label: "Date", value: "27th May to 20th June" },
      { label: "Age", value: "3 years to 12 years" },
      { label: "Fee", value: "Rs. 15,000/." },
    ],
  },
  {
    variant: "offers",
    items: [
      { label: "Early Bird Discount", value: "15% — Rs. 12,750/." },
      { label: "Group Discount", value: "20% — Rs. 12,000/." },
    ],
  },
];

const fallbackBodyLines = [
  "Let's make this a summer to cherish and remember.",
  "Sign up today, and let the adventure begin.",
];

const fallbackTextFields = [
  { key: "name", label: "Name", type: "text", required: true, inputMode: "text", pattern: "" },
  { key: "class", label: "Class", type: "text", required: true, inputMode: "text", pattern: "" },
  { key: "age", label: "Age", type: "text", required: true, inputMode: "text", pattern: "" },
  {
    key: "schoolName",
    label: "School Name",
    type: "text",
    required: true,
    inputMode: "text",
    pattern: "",
  },
  {
    key: "fatherName",
    label: "Father Name",
    type: "text",
    required: true,
    inputMode: "text",
    pattern: "",
  },
  {
    key: "motherName",
    label: "Mother Name",
    type: "text",
    required: true,
    inputMode: "text",
    pattern: "",
  },
  {
    key: "fatherContact",
    label: "Father Contact Number",
    type: "tel",
    required: true,
    inputMode: "numeric",
    pattern: "[0-9]+",
  },
  {
    key: "motherContact",
    label: "Mother Contact Number",
    type: "tel",
    required: true,
    inputMode: "numeric",
    pattern: "[0-9]+",
  },
];

const fallbackChoiceGroups = [
  {
    key: "attendedPast",
    prompt: "Have you attended Kiva Kamp in the past?",
    required: true,
    options: [
      { label: "Yes", value: "Yes" },
      { label: "No", value: "No" },
    ],
  },
  {
    key: "sibling",
    prompt: "Do you have a sibling enrolled at The Kiva School or The AMI School?",
    required: true,
    options: [
      { label: "Yes", value: "Yes" },
      { label: "No", value: "No" },
    ],
  },
  {
    key: "group",
    prompt:
      "Are you registering as a group of 3 or more children? Please note, you're eligible for a 20% Group Discount till 9th May.",
    required: true,
    options: [
      { label: "Yes", value: "Yes" },
      { label: "No", value: "No" },
    ],
  },
  {
    key: "referral",
    prompt: "Where did you hear about us?",
    required: true,
    options: [
      { label: "Social Media", value: "Social Media" },
      { label: "Word of Mouth", value: "Word of Mouth" },
      { label: "Website", value: "Website" },
      { label: "Friend", value: "Friend" },
    ],
  },
];

const entries = await getCollection("kivaKampForm");
const data = entries[0]?.data;

const bannerSlides = (
  data?.bannerSlides?.length ? data.bannerSlides : fallbackBannerSlides
).map((image) => ({
  src: image?.src ?? "",
  alt: image?.alt ?? "",
}));

const cardGroups = (
  data?.cardGroups?.length ? data.cardGroups : fallbackCardGroups
).map((group) => ({
  variant: group?.variant ?? "details",
  items: (group?.items ?? []).map((item) => ({
    label: item?.label ?? "",
    value: item?.value ?? "",
  })),
}));

const bodyLines = (
  data?.intro?.bodyLines?.length ? data.intro.bodyLines : fallbackBodyLines
)
  .map((line) => line ?? "")
  .filter((line) => line.length > 0);

const textFields = (
  data?.form?.textFields?.length ? data.form.textFields : fallbackTextFields
).map((field) => ({
  key: field?.key ?? "",
  label: field?.label ?? "",
  type: field?.type ?? "text",
  required: field?.required ?? false,
  inputMode: field?.inputMode ?? "",
  pattern: field?.pattern ?? "",
}));

const choiceGroups = (
  data?.form?.choiceGroups?.length
    ? data.form.choiceGroups
    : fallbackChoiceGroups
).map((group) => ({
  key: group?.key ?? "",
  prompt: group?.prompt ?? "",
  required: group?.required ?? false,
  options: (group?.options ?? []).map((option) => ({
    label: option?.label ?? option?.value ?? "",
    value: option?.value ?? option?.label ?? "",
  })),
}));

const introTitle = data?.intro?.title ?? "Kiva Kamp 2026";
const introKicker =
  data?.intro?.kicker ??
  "Pack your school books away, it's time to Kamp the Kiva way! ☀️";
const introLeadHtml =
  richTextToHtml(data?.intro?.lead) ||
  "<p><strong>Summers at Kiva</strong> will be a whirlwind of exploration, creation, learning and of course, play!</p>";
const contactText =
  data?.intro?.contactText ?? "For further information please contact:";
const contactNumber = data?.intro?.contactNumber ?? "0306 5329813";
const disclaimer =
  data?.intro?.disclaimer ??
  "*Discounts are eligible till 9th May, after which the standard fee — Rs. 15,000 will be applicable.";

const formTitle = data?.form?.title ?? "REGISTER";
const submitButtonText = data?.form?.submitButtonText ?? "Submit";
const successTitle = data?.form?.successTitle ?? "Registration received";
const successMessage =
  data?.form?.successMessage ??
  "Thanks for signing up! We'll be in touch shortly.";
---

<BaseLayout pageTitle={null} heroSrc={null}>
  <HeroSlideshow slot="hero" images={bannerSlides} intervalMs={3800} />

  <PageSection contentWidth="narrow">
    <div class="kamp-intro">
      <h1 class="kamp-intro__title">{introTitle}</h1>
      <p class="kamp-intro__kicker">{introKicker}</p>
      <div class="kamp-intro__lead" set:html={introLeadHtml} />

      {
        cardGroups.map((group, groupIndex) => (
          <Fragment>
            <div
              class={`kamp-card-group kamp-card-group--${group.variant}`}
              aria-label={group.variant === "offers" ? "Discounts" : "Kamp details"}
            >
              {group.items.map((item) => (
                <p class="kamp-card-group__item">
                  <strong>{item.label}</strong>
                  <span>{item.value}</span>
                </p>
              ))}
            </div>

            {bodyLines[groupIndex] && (
              <p class="kamp-intro__body">{bodyLines[groupIndex]}</p>
            )}
          </Fragment>
        ))
      }

      {
        bodyLines.slice(cardGroups.length).map((line) => (
          <p class="kamp-intro__body">{line}</p>
        ))
      }

      <p class="kamp-intro__contact">
        {contactText} <strong>{contactNumber}</strong>
      </p>
      <p class="kamp-disclaimer">{disclaimer}</p>
    </div>
  </PageSection>

  <PageSection title={formTitle}>
    <form class="kamp-form" id="kamp-form">
      <div class="form-grid">
        {
          textFields.map((field) => (
            <label class="form-field">
              <input
                type={field.type}
                name={field.key}
                placeholder=" "
                required={field.required}
                inputmode={field.inputMode || undefined}
                pattern={field.pattern || undefined}
              />
              <span>{field.label}</span>
            </label>
          ))
        }
      </div>

      {
        choiceGroups.map((group) => (
          <fieldset class="form-choice">
            <legend>{group.prompt}</legend>
            <p class="form-choice__prompt" aria-hidden="true">
              {group.prompt}
            </p>
            <div class="form-choice__options">
              {
                group.options.map((option, optionIndex) => (
                  <label class="form-choice__option">
                    <input
                      type="radio"
                      name={group.key}
                      value={option.value}
                      required={group.required && optionIndex === 0}
                    />
                    <span>{option.label}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>
        ))
      }

      <div class="form-actions">
        <button type="submit" class="primary-button">{submitButtonText}</button>
      </div>
    </form>

    <FormNotification
      id="kamp-success"
      title={successTitle}
      message={successMessage}
    />
  </PageSection>
</BaseLayout>

<style>
  .kamp-intro {
    color: var(--color-text-primary);
    width: min(100%, 760px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .kamp-intro p {
    margin: 0;
    max-width: 60ch;
    line-height: 1.7;
  }

  .kamp-intro__title {
    margin: 0;
    color: var(--color-teal);
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 1000;
  }

  .kamp-intro__kicker {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    font-weight: 700;
    color: var(--color-deep-teal);
    max-width: 34ch;
  }

  .kamp-intro__lead {
    max-width: 42ch;
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    line-height: 1.6;
  }

  .kamp-intro__lead :global(p) {
    margin: 0;
  }

  .kamp-card-group {
    width: 100%;
    display: grid;
    gap: 1rem;
  }

  .kamp-card-group--details {
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }

  .kamp-card-group--offers {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .kamp-card-group__item {
    margin: 0;
    background: var(--color-warm-yellow);
    border-radius: var(--radius-md);
    padding: 1.1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    align-items: center;
    text-align: center;
    line-height: 1.45;
  }

  .kamp-card-group__item strong {
    color: var(--color-teal);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .kamp-card-group__item span {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .kamp-intro__body {
    margin-block: 0.5rem;
    max-width: 48ch;
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    line-height: 1.6;
  }

  .kamp-intro__contact {
    font-weight: 600;
    color: var(--color-deep-teal);
  }

  .kamp-disclaimer {
    font-size: 0.9rem;
    font-style: italic;
    opacity: 0.85;
    max-width: 56ch;
  }

  .kamp-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    text-align: left;
  }

  .form-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .form-field {
    position: relative;
    display: flex;
    flex-direction: column;
    font-size: 0.95rem;
  }

  .form-field span {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.7);
    pointer-events: none;
    transition: all 0.2s ease;
    background: transparent;
  }

  .form-field input {
    border: none;
    border-radius: 18px;
    padding: 1.4rem 1rem 0.6rem;
    font-size: 1rem;
    background: #d59bed;
    color: var(--color-text-inverse);
    width: 100%;
    box-sizing: border-box;
    font-family: inherit;
  }

  .form-field input:focus + span,
  .form-field input:not(:placeholder-shown) + span {
    top: 0.5rem;
    transform: translateY(0);
    font-size: 0.6rem;
    color: white;
  }

  .form-choice {
    border: none;
    padding: 1rem 1.25rem 1.25rem;
    margin: 0;
    background: #d59bed;
    border-radius: 18px;
    color: var(--color-text-inverse);
  }

  .form-choice legend {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .form-choice__prompt {
    margin: 0 0 0.75rem;
    font-weight: 600;
    color: white;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .form-choice__options {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }

  .form-choice__option {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    color: var(--color-text-inverse);
    font-size: 0.95rem;
  }

  .form-choice__option input {
    accent-color: var(--color-teal);
    margin: 0;
    width: 1rem;
    height: 1rem;
  }

  .form-actions {
    display: flex;
    justify-content: center;
  }

  .primary-button {
    background: #d59bed;
    color: var(--color-text-inverse);
    border: none;
    border-radius: 999px;
    padding: 0.85rem 2.5rem;
    font-size: 1rem;
    cursor: pointer;
  }

  .primary-button:hover {
    background: #b878d8;
  }

  @media (max-width: 720px) {
    .kamp-intro {
      gap: 1.15rem;
    }

    .kamp-card-group {
      grid-template-columns: 1fr;
    }

    .kamp-intro__lead,
    .kamp-intro__body {
      font-size: 1.15rem;
    }
  }
</style>

<script>
  const form = document.getElementById("kamp-form") as HTMLFormElement | null;
  const notification = document.getElementById("kamp-success");

  const stripNonDigits = (e: Event) => {
    const target = e.target as HTMLInputElement;
    target.value = target.value.replace(/[^0-9]/g, "");
  };

  form
    ?.querySelectorAll<HTMLInputElement>('input[type="tel"]')
    .forEach((el) => el.addEventListener("input", stripNonDigits));

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (form) form.style.display = "none";
    if (notification) notification.style.display = "flex";
  });
</script>
