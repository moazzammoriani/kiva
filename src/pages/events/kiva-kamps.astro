---
import BaseLayout from "../../layouts/BaseLayout.astro";
import heroImage from "../../assets/Banner_KivaKamp.webp";
import PageSection from "../../components/PageSection.astro";
import FormNotification from "../../components/FormNotification.astro";
---

<BaseLayout pageTitle={null} heroSrc={heroImage.src}>
    <PageSection contentWidth="narrow">
        <div class="kamp-intro">
            <h1 class="kamp-intro__title">Kiva Kamp 2026</h1>
            <p class="kamp-intro__kicker">
                Pack your school books away, it's time to Kamp the Kiva way! ☀️
            </p>
            <p class="kamp-intro__lead">
                <strong>Summers at Kiva</strong> will be a whirlwind of
                exploration, creation, learning and of course, play!
            </p>
            <div class="kamp-details" aria-label="Kamp details">
                <p class="kamp-details__item">
                    <strong>Date</strong>
                    <span>27th May to 20th June</span>
                </p>
                <p class="kamp-details__item">
                    <strong>Age</strong>
                    <span>3 years to 12 years</span>
                </p>
                <p class="kamp-details__item">
                    <strong>Fee</strong>
                    <span>Rs. 15,000/.</span>
                </p>
            </div>
            <p class="kamp-intro__body">
                Let's make this a summer to cherish and remember.
            </p>
            <div class="kamp-offers" aria-label="Discounts">
                <p class="kamp-offers__item">
                    <strong>Early Bird Discount</strong>
                    <span>15% — Rs. 12,750/.</span>
                </p>
                <p class="kamp-offers__item">
                    <strong>Group Discount</strong>
                    <span>20% — Rs. 12,000/.</span>
                </p>
            </div>
            <p class="kamp-intro__body">Sign up today, and let the adventure begin.</p>
            <p class="kamp-intro__contact">
                For further information please contact: <strong>0306 5329813</strong>
            </p>
            <p class="kamp-disclaimer">
                *Discounts are eligible till 9th May, after which the standard
                fee — Rs. 15,000 will be applicable.
            </p>
        </div>
    </PageSection>

    <PageSection title="REGISTER">
        <form class="kamp-form" id="kamp-form">
            <div class="form-grid">
                <label class="form-field">
                    <input type="text" name="name" placeholder=" " required />
                    <span>Name</span>
                </label>
                <label class="form-field">
                    <input type="text" name="class" placeholder=" " required />
                    <span>Class</span>
                </label>
                <label class="form-field">
                    <input type="text" name="age" placeholder=" " required />
                    <span>Age</span>
                </label>
                <label class="form-field">
                    <input type="text" name="schoolName" placeholder=" " required />
                    <span>School Name</span>
                </label>
                <label class="form-field">
                    <input type="text" name="fatherName" placeholder=" " required />
                    <span>Father Name</span>
                </label>
                <label class="form-field">
                    <input type="text" name="motherName" placeholder=" " required />
                    <span>Mother Name</span>
                </label>
                <label class="form-field">
                    <input
                        type="tel"
                        name="fatherContact"
                        placeholder=" "
                        required
                        inputmode="numeric"
                        pattern="[0-9]+"
                    />
                    <span>Father Contact Number</span>
                </label>
                <label class="form-field">
                    <input
                        type="tel"
                        name="motherContact"
                        placeholder=" "
                        required
                        inputmode="numeric"
                        pattern="[0-9]+"
                    />
                    <span>Mother Contact Number</span>
                </label>
            </div>

            <fieldset class="form-choice">
                <legend>Have you attended Kiva Kamp in the past?</legend>
                <p class="form-choice__prompt" aria-hidden="true">
                    Have you attended Kiva Kamp in the past?
                </p>
                <div class="form-choice__options">
                    <label class="form-choice__option">
                        <input type="radio" name="attendedPast" value="Yes" required />
                        <span>Yes</span>
                    </label>
                    <label class="form-choice__option">
                        <input type="radio" name="attendedPast" value="No" />
                        <span>No</span>
                    </label>
                </div>
            </fieldset>

            <fieldset class="form-choice">
                <legend>
                    Do you have a sibling enrolled at The Kiva School or The AMI School?
                </legend>
                <p class="form-choice__prompt" aria-hidden="true">
                    Do you have a sibling enrolled at The Kiva School or The AMI
                    School?
                </p>
                <div class="form-choice__options">
                    <label class="form-choice__option">
                        <input type="radio" name="sibling" value="Yes" required />
                        <span>Yes</span>
                    </label>
                    <label class="form-choice__option">
                        <input type="radio" name="sibling" value="No" />
                        <span>No</span>
                    </label>
                </div>
            </fieldset>

            <fieldset class="form-choice">
                <legend>
                    Are you registering as a group of 3 or more children? Please
                    note, you're eligible for a 20% Group Discount till 9th May.
                </legend>
                <p class="form-choice__prompt" aria-hidden="true">
                    Are you registering as a group of 3 or more children? Please
                    note, you're eligible for a 20% Group Discount till 9th May.
                </p>
                <div class="form-choice__options">
                    <label class="form-choice__option">
                        <input type="radio" name="group" value="Yes" required />
                        <span>Yes</span>
                    </label>
                    <label class="form-choice__option">
                        <input type="radio" name="group" value="No" />
                        <span>No</span>
                    </label>
                </div>
            </fieldset>

            <fieldset class="form-choice">
                <legend>Where did you hear about us?</legend>
                <p class="form-choice__prompt" aria-hidden="true">
                    Where did you hear about us?
                </p>
                <div class="form-choice__options">
                    <label class="form-choice__option">
                        <input type="radio" name="referral" value="Social Media" required />
                        <span>Social Media</span>
                    </label>
                    <label class="form-choice__option">
                        <input type="radio" name="referral" value="Word of Mouth" />
                        <span>Word of Mouth</span>
                    </label>
                    <label class="form-choice__option">
                        <input type="radio" name="referral" value="Website" />
                        <span>Website</span>
                    </label>
                    <label class="form-choice__option">
                        <input type="radio" name="referral" value="Friend" />
                        <span>Friend</span>
                    </label>
                </div>
            </fieldset>

            <div class="form-actions">
                <button type="submit" class="primary-button">Submit</button>
            </div>
        </form>

        <FormNotification
            id="kamp-success"
            title="Registration received"
            message="Thanks for signing up! We'll be in touch shortly."
        />
    </PageSection>
</BaseLayout>

<style>
    .kamp-intro {
        color: var(--color-text-primary);
        width: min(100%, 760px);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
        text-align: center;
    }

    .kamp-intro p {
        margin: 0;
        max-width: 60ch;
        line-height: 1.7;
    }

    .kamp-intro__title {
        margin: 0;
        color: var(--color-teal);
        font-size: clamp(2rem, 4.5vw, 3.4rem);
        line-height: 1.1;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        font-weight: 1000;
    }

    .kamp-intro__kicker {
        font-size: clamp(1.05rem, 2vw, 1.3rem);
        font-weight: 700;
        color: var(--color-deep-teal);
        max-width: 34ch;
    }

    .kamp-intro__lead {
        font-size: clamp(1.2rem, 2.4vw, 1.55rem);
        line-height: 1.6;
        max-width: 42ch;
    }

    .kamp-details {
        width: 100%;
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    }

    .kamp-details__item,
    .kamp-offers__item {
        margin: 0;
        background: var(--color-warm-yellow);
        border-radius: var(--radius-md);
        padding: 1.1rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        align-items: center;
        text-align: center;
        line-height: 1.45;
    }

    .kamp-details__item strong,
    .kamp-offers__item strong {
        color: var(--color-teal);
        font-size: 0.9rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .kamp-details__item span,
    .kamp-offers__item span {
        font-size: 1rem;
        font-weight: 700;
        color: var(--color-text-primary);
    }

    .kamp-intro__body {
        margin-block: 0.5rem;
        max-width: 48ch;
        font-size: clamp(1.2rem, 2.4vw, 1.55rem);
        line-height: 1.6;
    }

    .kamp-offers {
        width: 100%;
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .kamp-intro__contact {
        font-weight: 600;
        color: var(--color-deep-teal);
    }

    .kamp-disclaimer {
        font-size: 0.9rem;
        font-style: italic;
        opacity: 0.85;
        max-width: 56ch;
    }

    .kamp-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        text-align: left;
    }

    .form-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .form-field {
        position: relative;
        display: flex;
        flex-direction: column;
        font-size: 0.95rem;
    }

    .form-field span {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        font-weight: 500;
        color: rgba(255, 255, 255, 0.7);
        pointer-events: none;
        transition: all 0.2s ease;
        background: transparent;
    }

    .form-field input {
        border: none;
        border-radius: 18px;
        padding: 1.4rem 1rem 0.6rem;
        font-size: 1rem;
        background: #d59bed;
        color: var(--color-text-inverse);
        width: 100%;
        box-sizing: border-box;
        font-family: inherit;
    }

    .form-field input:focus + span,
    .form-field input:not(:placeholder-shown) + span {
        top: 0.5rem;
        transform: translateY(0);
        font-size: 0.6rem;
        color: white;
    }

    .form-choice {
        border: none;
        padding: 1rem 1.25rem 1.25rem;
        margin: 0;
        background: #d59bed;
        border-radius: 18px;
        color: var(--color-text-inverse);
    }

    .form-choice legend {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
    }

    .form-choice__prompt {
        margin: 0 0 0.75rem;
        font-weight: 600;
        color: white;
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .form-choice__options {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        align-items: flex-start;
    }

    .form-choice__option {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        cursor: pointer;
        color: var(--color-text-inverse);
        font-size: 0.95rem;
    }

    .form-choice__option input {
        accent-color: var(--color-teal);
        margin: 0;
        width: 1rem;
        height: 1rem;
    }

    .form-actions {
        display: flex;
        justify-content: center;
    }

    .primary-button {
        background: #d59bed;
        color: var(--color-text-inverse);
        border: none;
        border-radius: 999px;
        padding: 0.85rem 2.5rem;
        font-size: 1rem;
        cursor: pointer;
    }

    .primary-button:hover {
        background: #b878d8;
    }

    @media (max-width: 720px) {
        .kamp-intro {
            gap: 1.15rem;
        }

        .kamp-details,
        .kamp-offers {
            grid-template-columns: 1fr;
        }

        .kamp-intro__lead,
        .kamp-intro__body {
            font-size: 1.15rem;
        }
    }
</style>

<script>
    const form = document.getElementById("kamp-form") as HTMLFormElement | null;
    const notification = document.getElementById("kamp-success");

    const stripNonDigits = (e: Event) => {
        const target = e.target as HTMLInputElement;
        target.value = target.value.replace(/[^0-9]/g, "");
    };
    form
        ?.querySelectorAll<HTMLInputElement>('input[type="tel"]')
        .forEach((el) => el.addEventListener("input", stripNonDigits));

    form?.addEventListener("submit", (e) => {
        e.preventDefault();
        if (form) form.style.display = "none";
        if (notification) notification.style.display = "flex";
    });
</script>
