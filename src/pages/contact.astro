---
import BaseLayout from "../layouts/BaseLayout.astro";
import heroImage from "../assets/Banner_ContactUs.png";
import PageSection from "../components/PageSection.astro";
import SectionBreakLeaf from "../components/SectionBreakLeaf.astro";
import phone from "../assets/contact_phone_icon.png";
import location from "../assets/contact_location_icon.png";
import email from "../assets/contact_email_icon.png";
---

<BaseLayout pageTitle={null} heroSrc={heroImage.src}>
    <!-- <div class="leaf-divider" aria-hidden="true">🍃</div> -->

    <SectionBreakLeaf />
    <PageSection title="DROP US A MESSAGE">
        <form class="contact-form">
            <div class="form-grid">
                <label class="form-field">
                    <span>Name</span>
                    <input type="text" name="name" required />
                </label>
                <label class="form-field">
                    <span>Email Address</span>
                    <input type="email" name="email" required />
                </label>
                <label class="form-field">
                    <span>Subject</span>
                    <input type="text" name="subject" />
                </label>
                <label class="form-field">
                    <span>Cellphone Number</span>
                    <input type="tel" name="phone" />
                </label>
            </div>
            <label class="form-field">
                <span>Message</span>
                <textarea name="message" rows={4} required></textarea>
            </label>
            <div class="form-actions">
                <button type="submit" class="primary-button">Submit</button>
            </div>
        </form>
    </PageSection>

    <SectionBreakLeaf />
    <PageSection>
        <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3619.956712137171!2d67.0737774!3d24.865328!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3eb33f7bdf724f3f%3A0xcf5e9b30d2cf7b4e!2sThe%20Kiva%20School!5e0!3m2!1sen!2s!4v1762774280783!5m2!1sen!2s"
            width="800"
            height="450"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
    </PageSection>

    <SectionBreakLeaf />
    <PageSection>
        <div class="contact-highlights">
            <div class="contact-card">
                <img class="contact-icon" src={phone.src} />
                <span class="contact-label">0300-060 (KIVA)</span>
            </div>
            <div class="contact-card">
                <img class="contact-icon" src={location.src} />
                <span class="contact-label">32/E PECHS Block 6, Karachi</span>
            </div>
            <div class="contact-card">
                <img class="contact-icon" src={email.src} />
                <span class="contact-label">info@thekivaschool.com</span>
            </div>
        </div>
    </PageSection>
</BaseLayout>

<style>
    .contact-highlights {
        display: grid;
        gap: 1.5rem;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        width: 100%;
    }

    .contact-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        color: var(--color-text-primary);
    }

    .contact-icon {
        font-size: 2rem;
        color: #c165dd;
        height: 60px;
    }

    .contact-label {
        text-align: center;
    }

    .leaf-divider {
        font-size: 1.8rem;
        color: var(--color-teal);
        text-align: center;
    }

    .contact-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .form-field {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        font-size: 0.95rem;
    }

    .form-field span {
        text-align: left;
        font-weight: 800;
        color: var(--color-text-primary);
        padding-left: 14px;
    }

    .form-field input,
    .form-field textarea {
        border: none;
        border-radius: 18px;
        padding: 0.85rem 1rem;
        font-size: 1rem;
        background: #d59bed;
        color: var(--color-text-inverse);
    }

    .form-field input::placeholder,
    .form-field textarea::placeholder {
        color: rgba(255, 255, 255, 0.85);
    }

    .form-field textarea {
        resize: vertical;
    }

    .form-actions {
        display: flex;
        justify-content: center;
    }

    .primary-button {
        background: #d59bed;
        color: var(--color-text-inverse);
        border: none;
        border-radius: 999px;
        padding: 0.85rem 2.5rem;
        font-size: 1rem;
        cursor: pointer;
    }

    .primary-button:hover {
        background: #b878d8;
    }

    @media (max-width: 720px) {
        .contact-icon {
            font-size: 1.6rem;
        }
    }
</style>
