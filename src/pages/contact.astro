---
import BaseLayout from "../layouts/BaseLayout.astro";
import heroImage from "../assets/Banner_ContactUs.webp";
import PageSection from "../components/PageSection.astro";
import SectionBreakLeaf from "../components/SectionBreakLeaf.astro";
import FormNotification from "../components/FormNotification.astro";
import phone from "../assets/contact_phone_icon.webp";
import location from "../assets/contact_location_icon.webp";
import email from "../assets/contact_email_icon.webp";
import { PHONE_INPUT_PATTERN } from "../utils/phone";
---

<BaseLayout pageTitle={null} heroSrc={heroImage.src}>
    <!-- <div class="leaf-divider" aria-hidden="true">🍃</div> -->

    <PageSection title="DROP US A MESSAGE">
        <form class="contact-form" id="contact-form">
            <div class="form-grid">
                <label class="form-field">
                    <input type="text" name="name" placeholder=" " required />
                    <span>Name</span>
                </label>
                <label class="form-field">
                    <input type="email" name="email" placeholder=" " required />
                    <span>Email Address</span>
                </label>
                <label class="form-field">
                    <input type="text" name="subject" placeholder=" " required />
                    <span>Subject</span>
                </label>
                <label class="form-field">
                    <input
                        type="tel"
                        name="phone"
                        placeholder=" "
                        required
                        inputmode="tel"
                        pattern={PHONE_INPUT_PATTERN}
                        data-phone-field="true"
                    />
                    <span>Cellphone Number</span>
                </label>
            </div>
            <label class="form-field form-field--textarea">
                <textarea name="message" rows={4} placeholder=" " required></textarea>
                <span>Message</span>
            </label>
            <div class="form-actions">
                <button type="submit" class="primary-button">Submit</button>
            </div>
        </form>
        <FormNotification
            id="contact-success"
            title="Message Sent"
            message="Thank you for reaching out! We will get back to you soon."
        />
    </PageSection>

    <SectionBreakLeaf />
    <PageSection>
        <iframe
            class="mapembed"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3619.956712137171!2d67.0737774!3d24.865328!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3eb33f7bdf724f3f%3A0xcf5e9b30d2cf7b4e!2sThe%20Kiva%20School!5e0!3m2!1sen!2s!4v1762774280783!5m2!1sen!2s"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
    </PageSection>

    <PageSection>
        <div class="contact-highlights stack-lg">
            <div class="contact-card">
                <img class="contact-icon" src={phone.src} />
                <span class="contact-label">0300-060 (KIVA)</span>
            </div>
            <div class="contact-card">
                <img class="contact-icon" src={location.src} />
                <span class="contact-label">32/E PECHS Block 6, Karachi</span>
            </div>
            <div class="contact-card">
                <img class="contact-icon" src={email.src} />
                <span class="contact-label">info@thekivaschool.com</span>
            </div>
        </div>
    </PageSection>
</BaseLayout>

<style>
    .contact-highlights {
        display: flex;
        flex-direction: row;
        justify-content: space-around;
        margin: auto;
        gap: 1.5rem;
        max-width: 800px;
    }

    .contact-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        color: var(--color-text-primary);
    }

    .contact-icon {
        font-size: 2rem;
        color: #c165dd;
        height: 60px;
    }

    .contact-label {
        text-align: center;
    }

    .leaf-divider {
        font-size: 1.8rem;
        color: var(--color-teal);
        text-align: center;
    }

    .contact-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .form-field {
        position: relative;
        display: flex;
        flex-direction: column;
        font-size: 0.95rem;
    }

    .form-field span {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        font-weight: 500;
        color: rgba(255, 255, 255, 0.7);
        pointer-events: none;
        transition: all 0.2s ease;
        background: transparent;
    }

    .form-field input,
    .form-field textarea {
        border: none;
        border-radius: 18px;
        padding: 1.4rem 1rem 0.6rem;
        font-size: 1rem;
        background: #d59bed;
        color: var(--color-text-inverse);
    }

    /* Floating label state - focused or has content */
    .form-field input:focus + span,
    .form-field input:not(:placeholder-shown) + span {
        top: 0.5rem;
        transform: translateY(0);
        font-size: 0.6rem;
        color: white;
    }

    /* Textarea specific adjustments */
    .form-field--textarea span {
        top: 1.2rem;
        transform: translateY(0);
    }

    .form-field textarea:focus + span,
    .form-field textarea:not(:placeholder-shown) + span {
        top: 0.4rem;
        font-size: 0.6rem;
        color: white;
    }

    .form-field textarea {
        resize: vertical;
        padding-top: 1.6rem;
    }

    .form-actions {
        display: flex;
        justify-content: center;
    }

    .primary-button {
        background: #d59bed;
        color: var(--color-text-inverse);
        border: none;
        border-radius: 999px;
        padding: 0.85rem 2.5rem;
        font-size: 1rem;
        cursor: pointer;
    }

    .primary-button:hover {
        background: #b878d8;
    }

    .mapembed {
        width: 60vw;
        height: 40vw;
    }

    @media (max-width: 720px) {
        .mapembed {
            width: 90vw;
            height: 80vw;
        }
        
        .contact-highlights {
            flex-direction: column;
            justify-content: flex-start;
            gap: 48px;
        }
        .contact-icon {
            font-size: 1.6rem;
        }
    }

</style>

<script>
    import {
        normalizePakistanMobileField,
        setupPakistanMobileField,
    } from "../utils/phone";

    const form = document.getElementById('contact-form') as HTMLFormElement;
    const notification = document.getElementById('contact-success');

    const phoneFields = Array.from(
        document.querySelectorAll<HTMLInputElement>('input[data-phone-field="true"]'),
    );
    phoneFields.forEach(setupPakistanMobileField);

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        for (const field of phoneFields) {
            if (!normalizePakistanMobileField(field)) {
                field.reportValidity();
                field.focus();
                return;
            }
        }

        const formData = new FormData(form);
        try {
            const response = await fetch('/api/contact', {
                method: 'POST',
                body: formData,
            });
            if (response.ok) {
                form.style.display = 'none';
                if (notification) notification.style.display = 'flex';
            } else {
                alert('Something went wrong. Please try again.');
            }
        } catch (error) {
            alert('Something went wrong. Please try again.');
        }
    });
</script>
