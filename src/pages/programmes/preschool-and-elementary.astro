---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageSection from "../../components/PageSection.astro";
import Accordion from "../../components/Accordion.astro";
import GalleryDisplay from "../../components/GalleryDisplay.astro";
import SectionBreakLeaf from "../../components/SectionBreakLeaf.astro";
import PreschoolAgeTable from "../../components/PreschoolAgeTable.astro";
import YellowButton from "../../components/YellowButton.astro";
import { richTextToHtml } from "../../utils/richTextToHtml";

const entries = await getCollection("preschool");
const data = entries[0]?.data;

const heroSrc = data?.heroImage ?? "/images/preschool/Banner_preschool.png";

const preschoolImgs = (data?.preschoolImages ?? []).map((img) => img.src ?? "");
const elementaryImgs = (data?.elementaryImages ?? []).map((img) => img.src ?? "");

const faqs = (data?.faqs ?? []).map((f) => ({
    title: f.title ?? "",
    content: richTextToHtml(f.content),
}));
---

<BaseLayout pageTitle={null} heroSrc={heroSrc}>
    <PageSection title={data?.preschoolTitle ?? "PRE-SCHOOL"} headingLevel={2} contentWidth="narrow">
        <div class="stack-lg" set:html={richTextToHtml(data?.preschoolIntro) || "<p>Through a purpose-built and immersive learning environment, children at Kiva are encouraged to feed their curiosity, by learning more about the world around them. Our resource-equipped classrooms and intentional outdoor spaces, beckon students to engage with their surroundings daily. Be it a cozy reading corner, a stroll through the vegetable garden, free play in the morning or an activity station within the classroom, students are encouraged to explore, create meaning, resolve conflicts and exercise all creative faculties at their disposal.</p>"} />
    </PageSection>

    <PageSection>
        <GalleryDisplay images={preschoolImgs} />
    </PageSection>

    <PageSection headingLevel={2} contentWidth="narrow">
        <div class="stack-lg" set:html={richTextToHtml(data?.curiosityApproach) || "<p>Kiva prides itself on its <strong>Curiosity Approach</strong> a blend of globally renowned teaching pedagogies; <strong>Finnish, Waldorf, Reggio Emilia, Montessori</strong> and <strong>The Forest School</strong>. This approach ensures an ever-evolving and adaptable approach to learning, which is developmentally appropriate for each child and at par with international learning standards.</p>"} />

        <PreschoolAgeTable ageGroups={data?.ageGroups} />
    </PageSection>

    <SectionBreakLeaf />

    <PageSection
        title={data?.elementaryTitle ?? "ELEMENTARY SCHOOL"}
        headingLevel={2}
        contentWidth="narrow"
    >
        <div class="stack-lg" set:html={richTextToHtml(data?.elementaryIntro) || "<p>To ensure a smooth transition from Pre-school to Elementary School, the tenets of our teaching philosophy remain similar, with a gradual advancement in subject matter.</p>"} />
    </PageSection>

    <PageSection>
        <GalleryDisplay images={elementaryImgs} />
    </PageSection>

    <PageSection headingLevel={2} contentWidth="narrow">
        <div class="stack-lg" set:html={richTextToHtml(data?.elementarySecond) || "<p>With a strong emphasis on personalized learning trajectories of each child, our focus remains on the individual progress and potential of our students.</p>"} />
    </PageSection>

    <PageSection>
        <YellowButton text={"Apply Now"} />
    </PageSection>

    {(data?.instagramEmbeds ?? []).length > 0 && (
        <PageSection>
            <div class="instagram-grid">
                {(data?.instagramEmbeds ?? []).map((e) => (
                    <Fragment set:html={e.embedCode ?? ""} />
                ))}
                <script is:inline async src="//www.instagram.com/embed.js"></script>
            </div>
        </PageSection>
    )}

    <!-- TODO: decrease space -->
    <PageSection title={data?.faqsTitle ?? "F.A.Qs"} headingLevel={2}>
        <div class="stack-lg">
            {faqs.map((f) => <Accordion title={f.title} content={f.content} />)}
        </div>
    </PageSection>
</BaseLayout>

<style>
    .instagram-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        justify-items: center;
    }

    .instagram-grid > :global(*) {
        height: 680px;
        overflow: hidden;
    }

    .instagram-grid :global(iframe) {
        height: 680px !important;
    }

    @media (max-width: 1024px) {
        .instagram-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 725px) {
        .instagram-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
