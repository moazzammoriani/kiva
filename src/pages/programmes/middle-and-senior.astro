---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageSection from "../../components/PageSection.astro";
import GalleryDisplay from "../../components/GalleryDisplay.astro";
import YellowButton from "../../components/YellowButton.astro";
import { richTextToHtml } from "../../utils/richTextToHtml";

const entries = await getCollection("middleAndSenior");
const data = entries[0]?.data;

const heroSrc = data?.heroImage ?? "/images/middle-and-senior/Banner_SeniorSchool.png";
const galleryImgs = (data?.galleryImages ?? []).map((img) => img.src ?? "");
---

<BaseLayout pageTitle={null} heroSrc={heroSrc}>
    <PageSection title={data?.title ?? "SENIOR SCHOOL"} headingLevel={2} />

    <PageSection>
        <GalleryDisplay images={galleryImgs} />
    </PageSection>

    <PageSection headingLevel={2} contentWidth="narrow">
        <div class="stack-lg">
            <Fragment set:html={richTextToHtml(data?.bodyText) || ""} />
            <YellowButton text={data?.buttonText ?? "Learn More"} link={data?.buttonLink ?? "https://amischool.edu.pk"} />
        </div>
    </PageSection>
</BaseLayout>
