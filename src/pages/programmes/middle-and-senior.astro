---
import BaseLayout from "../../layouts/BaseLayout.astro";
import heroImage from "../../assets/Banner_SeniorSchool.png";
import Accordion from "../../components/Accordion.astro";
---

<BaseLayout pageTitle={null} heroSrc={heroImage.src}>
  <section class="intro section" aria-labelledby="welcome-heading">
    <h1 id="welcome-heading" class="intro-heading">
      Middle & Senior<br /> School
    </h1>
    <div class="intro-copy">
      <p>
        Launched in 2021, Kiva School came into being after Muzaffar Bukhari of
        Veritas Learning Circle joined EWPL as a new partner. Bringing a fresh
        perspective and vision to the organisation, Kiva School was established
        as a new chapter of the AMI pre-school focusing on early developmental
        years from a place of curiosity and exploration.
      </p>
      <p>
        Breaking away from conventional teaching methods and adopting the
        Finnish play-based educational philosophy, Kiva embodies values of
        kindness and social responsibility that encourage personal growth at
        each child’s own pace.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  :root {
    --teal: #0db29b;
    --deep-teal: #05897a;
    --warm-yellow: #f6c65b;
    --text-primary: #214244;
    --text-muted: #5f7576;
  }

  .section {
    padding: 3rem 1.5rem;
    text-align: center;
  }

  .intro {
    padding-top: 2rem;
  }
  .intro-icon {
    font-size: 2.4rem;
    color: var(--teal);
    margin-bottom: 0.5rem;
  }
  .intro-heading {
    font-size: clamp(2.1rem, 3vw + 1rem, 3rem);
    line-height: 1.1;
    margin: 0.5rem 0 0;
    letter-spacing: 1.5px;
    color: var(--teal);
  }
  .intro-tagline {
    font-size: 1.15rem;
    color: var(--deep-teal);
    margin: 0.5rem 0 1.2rem;
  }
  .intro-copy {
    max-width: 68ch;
    margin: 0 auto;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
  }
  .intro-copy p {
    margin: 0 0 1rem;
  }

  .section-heading {
    font-size: clamp(1.6rem, 2vw + 1rem, 2.3rem);
    color: var(--teal);
    letter-spacing: 1.5px;
    margin-bottom: 1.5rem;
  }

  .space-placeholder {
    background: var(--warm-yellow);
    border-radius: 16px;
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    min-height: clamp(220px, 40vw, 420px);
  }
  .space-caption {
    margin-top: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .questions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    flex-direction: column;
    justify-content: center;
  }
  .logo-placeholder {
    background: var(--warm-yellow);
    border-radius: 12px;
    padding: 1rem;
    min-width: 140px;
    min-height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--deep-teal);
    font-weight: 600;
    text-align: center;
  }

  @media (max-width: 600px) {
    .section {
      padding: 2.5rem 1rem;
    }
    .logo-placeholder {
      min-width: 120px;
      min-height: 60px;
      font-size: 0.85rem;
    }
  }
</style>
