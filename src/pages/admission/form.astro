---
import BaseLayout from "../../layouts/BaseLayout.astro";
import heroImage from "../../assets/Banner_AdmissionForm.png";
import PageSection from "../../components/PageSection.astro";
---

<BaseLayout pageTitle={null} heroSrc={heroImage.src}>
  <PageSection title="Admission Form" headingLevel={1}>
    <div class="stack-lg">
      <p>
        At the Kiva School we aim to provide an admission process that is smooth
        and stress-free for parents. To initiate the admission process, please
        fill out the form below. A member from our Admissions Office will be in
        touch with you soon to communicate next steps.
      </p>
    </div>
  </PageSection>
</BaseLayout>
