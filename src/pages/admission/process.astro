---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageSection from "../../components/PageSection.astro";
import Accordion from "../../components/Accordion.astro";
import YellowButton from "../../components/YellowButton.astro";
import { richTextToHtml } from "../../utils/richTextToHtml";

const entries = await getCollection("admissionProcess");
const data = entries[0]?.data;

const heroSrc = data?.heroImage ?? "/images/admission-process/Banner_AdmissionProcess.png";

const faqs = (data?.faqs ?? []).map((f) => ({
    title: f.title ?? "",
    content: richTextToHtml(f.content),
}));
---

<BaseLayout pageTitle={null} heroSrc={heroSrc}>
    <PageSection
        title={data?.title ?? "ADMISSION PROCESS"}
        headingLevel={2}
        contentWidth="narrow"
    >
        <div class="diagram-container">
            <picture>
                <source srcset={(data?.processDiagram ?? "/images/admission-process/process_diagram.png").replace(/\.(png|jpe?g)$/i, ".webp")} type="image/webp" />
                <img class="process-diagram" src={data?.processDiagram ?? "/images/admission-process/process_diagram.png"} alt="" />
            </picture>
            <picture>
                <source srcset={(data?.processDiagramMobile ?? "/images/admission-process/process_diagram_mob.png").replace(/\.(png|jpe?g)$/i, ".webp")} type="image/webp" />
                <img
                    class="process-diagram-mob"
                    src={data?.processDiagramMobile ?? "/images/admission-process/process_diagram_mob.png"}
                    alt=""
                />
            </picture>
        </div>
        <div class="apply-now-btn-container">
            <YellowButton text={data?.buttonText ?? "Click here to apply"} />
        </div>
    </PageSection>
    <PageSection title={data?.faqsTitle ?? "F.A.Qs"} headingLevel={2}>
        <div class="stack-lg">
            {faqs.map((f) => <Accordion title={f.title} content={f.content} />)}
        </div>
    </PageSection>
</BaseLayout>

<style>
    .diagram-container {
        display: flex;
        justify-content: center;
    }
    .process-diagram {
        display: block;
        max-width: 900px;
    }
    .apply-now-btn-container {
        margin-top: 40px;
    }
    .process-diagram-mob {
        display: none;
    }

    @media (max-width: 915px) {
        .process-diagram {
            display: none;
        }
        .process-diagram-mob {
            display: inline;
            width: 80vw;
        }
    }
</style>
