---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageSection from "../../components/PageSection.astro";
import ValuesSection from "../../components/ValuesSection.astro";

const missionEntries = await getCollection("mission");
const mission = missionEntries[0]?.data;
---

<BaseLayout pageTitle={null} heroSrc={mission?.heroImage ?? ""}>
    <PageSection title="VISION" contentWidth="narrow">
        <p>
            {mission?.visionText ?? ""}
        </p>
    </PageSection>

    <PageSection title="MISSION" contentWidth="narrow">
        <p>
            {mission?.missionText ?? ""}
        </p>
    </PageSection>

    <PageSection title="VALUES">
        <ValuesSection
            sisuText={mission?.sisuText}
            inclusivityText={mission?.inclusivityText}
            socialResponsibilityText={mission?.socialResponsibilityText}
        />
    </PageSection>
</BaseLayout>
