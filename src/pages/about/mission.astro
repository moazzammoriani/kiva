---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageSection from "../../components/PageSection.astro";
import ValuesSection from "../../components/ValuesSection.astro";
import { richTextToHtml } from "../../utils/richTextToHtml";

const missionEntries = await getCollection("mission");
const mission = missionEntries[0]?.data;
---

<BaseLayout pageTitle={null} heroSrc={mission?.heroImage ?? ""}>
    <PageSection title="VISION" contentWidth="narrow">
        <Fragment set:html={richTextToHtml(mission?.visionText) || "<p></p>"} />
    </PageSection>

    <PageSection title="MISSION" contentWidth="narrow">
        <Fragment set:html={richTextToHtml(mission?.missionText) || "<p></p>"} />
    </PageSection>

    <PageSection title="VALUES">
        <ValuesSection
            sisuText={richTextToHtml(mission?.sisuText)}
            inclusivityText={richTextToHtml(mission?.inclusivityText)}
            socialResponsibilityText={richTextToHtml(mission?.socialResponsibilityText)}
        />
    </PageSection>
</BaseLayout>
