---
import BaseLayout from "../../layouts/BaseLayout.astro";
import heroImage from "../../assets/high-angle-child-woman-painting.jpg";
import PageSection from "../../components/PageSection.astro";

const values = [
  {
    title: "Sisu",
    description:
      "Resilience, perseverance, and courage in the face of challenges—instilled in every learner.",
  },
  {
    title: "Inclusivity",
    description:
      "A welcoming community where every child and family feels seen, supported, and empowered.",
  },
  {
    title: "Social Responsibility",
    description:
      "Learners who care for their communities and contribute thoughtfully to the world around them.",
  },
];
---

<BaseLayout pageTitle={null} heroSrc={heroImage.src}>
  <PageSection title="Vision" variant="panel" headingLevel={1} align="left">
    <div class="stack-lg">
      <p>
        To create an ecosystem that redefines expansion and growth in education by prioritising
        horizontal growth through supporting units and placing a holistic educational experience at
        the centre for students, teachers, and parents.
      </p>
      <p>
        By spearheading change within Pakistan’s educational landscape, EWPL reimagines expansion as
        the sustainable utilisation of its spaces to launch educational and community enrichment
        programmes, ensuring a holistic experience for all stakeholders.
      </p>
    </div>
  </PageSection>

  <PageSection title="Mission" variant="panel" align="left">
    <p>
      EWPL pursues improved educational standards while advancing community-wide change through
      action research. With a commitment to continuous improvement, every programme is designed to
      promote genuine learning and create a meaningful, lasting impact for everyone involved.
    </p>
  </PageSection>

  <PageSection title="Values" variant="panel">
    <div class="grid-responsive">
      {values.map((value) => (
        <article class="card-panel" aria-label={`${value.title} value`}>
          <div class="card-panel__media" role="img" aria-label={`${value.title} illustration placeholder`}></div>
          <h3 class="card-panel__title">{value.title}</h3>
          <p class="card-panel__body">{value.description}</p>
        </article>
      ))}
    </div>
  </PageSection>
</BaseLayout>
