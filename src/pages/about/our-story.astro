---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageSection from "../../components/PageSection.astro";

const fallbackHeroImage = "/images/our-story/our_story_banner.webp";
const fallbackTimelineImage = "/images/our-story/our_story_timeline.webp";
const fallbackMobileTimelineImage =
  "/images/our-story/our_story_timeline_mob.webp";

const storyEntries = await getCollection("ourStory");
const story = storyEntries[0]?.data;

const heroImage = story?.heroImage || fallbackHeroImage;
const timelineImage = story?.timelineImage || fallbackTimelineImage;
const timelineMobileImage =
  story?.timelineMobileImage || fallbackMobileTimelineImage;
---

<BaseLayout pageTitle={null} heroSrc={heroImage} heroAlt={story?.heroAlt ?? ""}>
  <PageSection title={story?.sectionTitle || "OUR STORY"}>
    <div class="timeline-container stack-lg timeline-container-desktop">
      <img
        class="timeline"
        src={timelineImage}
        alt={story?.timelineAlt ?? ""}
      />
    </div>
  </PageSection>
  <div class="timeline-mob-container">
    <img
      class="timeline-mob"
      src={timelineMobileImage}
      alt={story?.timelineAlt ?? ""}
    />
  </div>
</BaseLayout>

<style>
  .timeline {
    width: 100%;
  }
  .timeline-container {
    text-align: center;
    box-sizing: border-box;
    border: 16px solid var(--color-teal);
    border-radius: 71px;
  }

  .timeline-mob-container {
    display: none;
  }

  .timeline-mob {
    width: 100%;
  }

  @media (max-width: 485px) {
    .timeline-container-desktop {
      display: none;
    }

    .timeline-mob-container {
      display: block;
    }
  }
</style>
