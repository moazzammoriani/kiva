---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageSection from "../../components/PageSection.astro";
import heroImage from "../../assets/our_story_banner.png";
import timeline from "../../assets/our_story_timeline.png";
---

<BaseLayout pageTitle={null} heroSrc={heroImage.src}>
    <PageSection title="OUR STORY">
        <div class="timeline-container stack-lg">
            <img class="timeline" src={timeline.src} alt="" />
        </div>
    </PageSection>
</BaseLayout>;

<style>
    .timeline {
        width: 100%;
    }
    .timeline-container {
        text-align: center;
        box-sizing: border-box;
        border: 16px solid var(--color-teal);
        border-radius: 71px;
    }
</style>
