---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TeamSection from "../../components/TeamSection.astro";
import IntroBlock from "../../components/IntroBlock.astro";
import { richTextToHtml } from "../../utils/richTextToHtml";

const teamEntries = await getCollection("team");
const team = teamEntries[0]?.data;

const directors = (team?.directors ?? []).map((d) => ({
    name: d.name ?? "",
    bio: richTextToHtml(d.bio),
    imgSrc: d.image ?? "",
}));

const teamMembers = (team?.teamMembers ?? []).map((m) => ({
    name: m.name ?? "",
    bio: richTextToHtml(m.bio),
    imgSrc: m.image ?? "",
}));
---

<BaseLayout pageTitle="Meet the Team" heroSrc={team?.heroImage ?? ""}>
    <IntroBlock>
        <TeamSection title={team?.directorsTitle ?? "OUR DIRECTORS"} members={directors} />
    </IntroBlock>

    <IntroBlock>
        <TeamSection title={team?.teamTitle ?? "OUR TEAM"} members={teamMembers} />
    </IntroBlock>
</BaseLayout>
