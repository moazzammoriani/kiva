---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TeamSection from "../../components/TeamSection.astro";
import PageSection from "../../components/PageSection.astro";
import heroImage from "../../assets/high-angle-child-woman-painting.jpg";

const directors = [
  {
    name: "Nasira Faiz",
    bio: "Founder of Beginner's Montessori and co-creator of EWPL, Nasira brings four decades of Montessori leadership to the Kiva community. She pairs Montessori best practices with a focus on kindness, curiosity, and personalised pathways for young learners.",
  },
  {
    name: "Rabeea Minai",
    bio: "Rabeea heads the Seniors Involve Program (SIP) and leads community engagement efforts. Her work connects generations through active, intergenerational projects that celebrate lifelong learning.",
  },
  {
    name: "Saba Qadir",
    bio: "With more than twenty years in early years education, Saba has mentored educators across Pakistan. She guides curriculum design and educator development, ensuring every classroom is warm, inclusive, and intentional.",
  },
  {
    name: "Muzaffar Bukhari",
    bio: "Muzaffar partners with EWPL to grow Kiva School’s play-based learning approach. His experience founding Veritas Learning Circle helps bridge holistic academics with meaningful community partnerships.",
  },
];

const teamMembers = [
  {
    name: "Samreen Jawaid",
    bio: "Samreen is a specialist in early childhood education with 20+ years of experience. She mentors teachers on observation-led lesson design and supports families as children transition into primary grades.",
  },
  {
    name: "Bushra Umair",
    bio: "Bushra leads community enrichment programmes, collaborating with local partners to design joyful, hands-on learning experiences that extend beyond the classroom.",
  },
  {
    name: "Hiba Abdul Razzaq",
    bio: "Hiba focuses on programme operations and family partnerships. She keeps our learning environments running smoothly and ensures each Kiva family stays connected to the school’s mission.",
  },
];
---

<BaseLayout pageTitle="Meet the Team" heroSrc={heroImage.src}>
  <PageSection title="Meet the People of Kiva" headingLevel={1} description="A collective of educators, programme leads, and community builders who nurture curiosity, celebrate individuality, and keep our values alive every day." />

  <TeamSection title="Meet the Directors" members={directors} />
  <TeamSection title="Meet the Team" members={teamMembers} />
</BaseLayout>
