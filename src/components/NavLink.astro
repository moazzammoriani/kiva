---
const { link, text } = Astro.props as { link: string; text: string };

const rawBase = import.meta.env.BASE_URL || "/";
const trimmedBase = rawBase.replace(/\/$/, "");

const resolveHref = (href: string) => {
    const clean = href.startsWith("/") ? href : `/${href}`;
    if (trimmedBase === "") return clean;
    if (clean === "/") return `${trimmedBase}/`;
    return `${trimmedBase}${clean}`;
};

const resolvedLink = resolveHref(link);

const normalize = (value: string) =>
    value.endsWith("/") ? value : `${value}/`;
const currentPath = normalize(Astro.url.pathname);
const activeLink = normalize(resolvedLink);
const baseNormalized = normalize(trimmedBase || "/");

const active =
    currentPath === activeLink ||
    (activeLink !== baseNormalized && currentPath.startsWith(activeLink));
---

<a
    href={resolvedLink}
    class={`navlink${active ? " active" : ""}`}
    aria-current={active ? "page" : undefined}
>
    {text}
</a>

<style>
    :root {
        --teal: #0db29b;
        --text: #214244;
    }

    .navlink {
        font-weight: 500;
        display: inline-block;
        padding: 10px 16px;
        border-radius: 20px;
        text-decoration: none;
        color: var(--text);
        font-size: 16px;
        white-space: nowrap;
        transition:
            background-color 120ms ease,
            color 120ms ease;
    }
    .navlink:hover {
        background: var(--teal);
    }
    .navlink.active {
        background: var(--teal);
    }


    @media (max-width: 1420px) {
    .navlink {
        padding: 7px 14px;
        font-size: 16px;
        white-space: nowrap;
    }

    }
</style>
