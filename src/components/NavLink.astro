---
const { link, text } = Astro.props as { link: string; text: string };
const base = import.meta.env.BASE_URL;

const resolveHref = (href: string) => {
  if (href === "/") return base;
  const origin = base === "/" ? "http://example.com/" : `http://example.com${base}`;
  const sanitized = href.replace(/^\//, "");
  return new URL(sanitized, origin).pathname;
};

const resolvedLink = resolveHref(link);

const normalize = (value: string) => (value.endsWith("/") ? value : `${value}/`);
const currentPath = normalize(Astro.url.pathname);
const activeLink = normalize(resolvedLink);
const baseNormalized = normalize(base);

const active =
  currentPath === activeLink ||
  (activeLink !== baseNormalized && currentPath.startsWith(activeLink));
---

<a
  href={resolvedLink}
  class={`navlink${active ? " active" : ""}`}
  aria-current={active ? "page" : undefined}
>
  {text}
</a>

<style>
  :root {
    --teal: #0db29b;
    --text: #214244;
  }

  .navlink {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    border-radius: 20px;
    text-decoration: none;
    color: var(--text);
    line-height: 1;
    font-size: 0.95rem;
    white-space: nowrap;
    transition:
      background-color 120ms ease,
      color 120ms ease;
  }
  .navlink:hover {
    background: var(--teal);
  }
  .navlink.active {
    background: var(--teal);
    color: black;
  }
</style>
