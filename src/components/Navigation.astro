---
import { getCollection } from "astro:content";
import NavLink from "./NavLink.astro";
import NavDropdown from "./NavDropdown.astro";
import logo from "../assets/kiva-logo_home.webp";
import { navItems, staticAboutChildren, staticProgrammeChildren, staticAdmissionChildren, staticKivaSquareChildren } from "../data/navigation";

// Load CMS nav labels
const navEntries = await getCollection("navigation");
const nav = navEntries[0]?.data;

// Build flat key → label map from nested CMS data
const labelOverrides: Record<string, string> = {};
if (nav) {
  if (nav.homeLabel) labelOverrides["home"] = nav.homeLabel;
  if (nav.careersLabel) labelOverrides["careers"] = nav.careersLabel;
  if (nav.contactUsLabel) labelOverrides["contactUs"] = nav.contactUsLabel;
  if (nav.communityEnrichmentLabel) labelOverrides["communityEnrichment"] = nav.communityEnrichmentLabel;
  const aboutUs = nav.aboutUs?.[0];
  const programmes = nav.programmes?.[0];
  const admissions = nav.admissions?.[0];
  const kivaSquare = nav.kivaSquare?.[0];
  if (aboutUs?.label) labelOverrides["aboutUs"] = aboutUs.label;
  if (aboutUs?.ourStoryLabel) labelOverrides["aboutOurStory"] = aboutUs.ourStoryLabel;
  if (aboutUs?.missionLabel) labelOverrides["aboutMission"] = aboutUs.missionLabel;
  if (aboutUs?.teamLabel) labelOverrides["aboutTeam"] = aboutUs.teamLabel;
  if (programmes?.label) labelOverrides["programmes"] = programmes.label;
  if (programmes?.preschoolLabel) labelOverrides["progPreschool"] = programmes.preschoolLabel;
  if (programmes?.seniorLabel) labelOverrides["progSenior"] = programmes.seniorLabel;
  if (programmes?.kampsLabel) labelOverrides["progKamps"] = programmes.kampsLabel;
  if (admissions?.label) labelOverrides["admissions"] = admissions.label;
  if (admissions?.processLabel) labelOverrides["admProcess"] = admissions.processLabel;
  if (admissions?.formLabel) labelOverrides["admForm"] = admissions.formLabel;
  if (kivaSquare?.label) labelOverrides["kivaSquare"] = kivaSquare.label;
  if (kivaSquare?.year2024Label) labelOverrides["kSquare2024"] = kivaSquare.year2024Label;

}

const applyOverrides = (children: typeof staticAboutChildren) =>
  children.map((c) => ({ ...c, label: labelOverrides[c.key] ?? c.label }));

const aboutPages = await getCollection("aboutPages");
const dynamicAboutChildren = aboutPages
  .sort((a, b) => (a.data.navOrder ?? 999) - (b.data.navOrder ?? 999))
  .map((page) => ({
    label: page.data.navLabel || page.data.title || page.id,
    href: `/about/${page.data.slug || page.id}/`,
  }));

const programmePages = await getCollection("programmePages");
const dynamicProgrammeChildren = programmePages
  .sort((a, b) => (a.data.navOrder ?? 999) - (b.data.navOrder ?? 999))
  .map((page) => ({
    label: page.data.navLabel || page.data.title || page.id,
    href: `/programmes/${page.data.slug || page.id}/`,
  }));

const admissionPages = await getCollection("admissionPages");
const dynamicAdmissionChildren = admissionPages
  .sort((a, b) => (a.data.navOrder ?? 999) - (b.data.navOrder ?? 999))
  .map((page) => ({
    label: page.data.navLabel || page.data.title || page.id,
    href: `/admission/${page.data.slug || page.id}/`,
  }));

const kivaSquarePages = await getCollection("kivaSquarePages");
const dynamicKivaSquareChildren = kivaSquarePages
  .sort((a, b) => (a.data.navOrder ?? 999) - (b.data.navOrder ?? 999))
  .map((page) => ({
    label: page.data.navLabel || page.data.title || page.id,
    href: `/kiva_square/${page.data.slug || page.id}/`,
  }));

const resolvedNavItems = navItems.map((item) => {
  const overridden = { ...item, label: labelOverrides[item.key] ?? item.label };
  if (item.type === "group" && item.key === "aboutUs") {
    return { ...overridden, children: [...applyOverrides(staticAboutChildren), ...dynamicAboutChildren] };
  }
  if (item.type === "group" && item.key === "programmes") {
    return { ...overridden, children: [...applyOverrides(staticProgrammeChildren), ...dynamicProgrammeChildren] };
  }
  if (item.type === "group" && item.key === "admissions") {
    return { ...overridden, children: [...applyOverrides(staticAdmissionChildren), ...dynamicAdmissionChildren] };
  }
  if (item.type === "group" && item.key === "kivaSquare") {
    return { ...overridden, children: [...applyOverrides(staticKivaSquareChildren), ...dynamicKivaSquareChildren] };
  }
  return overridden;
});
---

<style>
    .top-nav {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 3rem;
        padding: 1.25rem clamp(1.5rem, 4vw, 3rem);
        max-width: 1200px;
        margin: 0 auto;
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        text-decoration: none;
        color: var(--color-text-primary, #214244);
        font-weight: 700;
        font-size: 1.1rem;
        letter-spacing: 0.04em;
        flex: 0 0 auto;
    }

    .brand img {
        height: 86px;
        width: auto;
        display: block;
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex: 1 1 auto;
        flex-wrap: nowrap;
        justify-content: flex-end;
    }

    .apply-btn {
        flex: 0 0 auto;
        display: inline-block;
        background: var(--color-purple, #ab75b2);
        color: var(--color-text-primary, #082c4b);
        font-weight: 800;
        font-size: 16px;
        padding: 10px 16px;
        border-radius: 20px;
        text-decoration: none;
        white-space: nowrap;
        transition: background 0.15s ease;
    }

    .apply-btn:hover {
        background: #9a63a1;
    }

    @media (max-width: 1420px) {
        .apply-btn {
            padding: 7px 14px;
            font-size: 16px;
        }
    }

    @media (max-width: 1304px) {
        .apply-btn {
            padding: 6px 12px;
            font-size: 13px;
        }
    }

    @media (max-width: 1064px) {
        .apply-btn {
            padding: 4px 8px;
            font-size: 13px;
        }
    }

    @media (max-width: 1010px) {
        .apply-btn {
            display: none;
        }
    }

    @media (max-width: 1420px) {
        .brand img {
            height: 60px;
            width: auto;
            display: block;
        }
    }

    @media (max-width: 1055px) {
        .top-nav {
            gap: 1.2rem;
        }
    }

    @media (max-width: 944px) {
        .top-nav {
            padding: 1rem 0.5rem;
            gap: 1rem;
        }

        .brand img {
            height: 40px;
        }
    }

    /* @media (max-width: 820px) { */
    /*     .brand img { */
    /*         height: 40px; */
    /*     } */
    /**/
    /*     .nav-links { */
    /*         gap: 0.2rem; */
    /*         justify-content: center; */
    /*         width: 100%; */
    /*     } */
    /**/
    /*     .top-nav { */
    /*         padding: 1rem 0; */
    /*         gap: 1rem; */
    /*         width: 90%; */
    /*     } */
    /* } */

    @media (max-width: 640px) {
        .brand span {
            display: none;
        }

        .nav-links {
            gap: 0.5rem;
            justify-content: center;
            width: 100%;
        }

        .top-nav {
            flex-direction: column;
            align-items: center;
        }
    }
</style>

<nav class="top-nav">
    <a class="brand" href="/">
        <img src={logo.src} alt="Kiva School" loading="lazy" />
        <!-- <span>Kiva School</span> -->
    </a>
    <div class="nav-links">
        {
            resolvedNavItems.map((item) =>
                item.type === "link" ? (
                    <NavLink link={item.href} text={item.label} />
                ) : (
                    <NavDropdown
                        baseLink={item.base}
                        label={item.label}
                        items={item.children.map((child) => ({
                            href: child.href,
                            text: child.label,
                            external: (child as any).external,
                        }))}
                    />
                ),
            )
        }
    </div>
    <a class="apply-btn" href="/admission/form/">Apply Now</a>
</nav>
