---
import NavLink from "./NavLink.astro";
import NavDropdown from "./NavDropdown.astro";
import logo from "../assets/kiva-logo_home.png";
import { navItems } from "../data/navigation";
---

<style>
    .top-nav {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 3rem;
        padding: 1.25rem clamp(1.5rem, 4vw, 3rem);
        max-width: 1200px; /*var(--layout-max-width, 1200px); */
        margin: 0 auto;
        width: 100%;
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        text-decoration: none;
        color: var(--color-text-primary, #214244);
        font-weight: 700;
        font-size: 1.1rem;
        letter-spacing: 0.04em;
        flex: 0 0 auto;
    }

    .brand img {
        height: 86px;
        width: auto;
        display: block;
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    @media (max-width: 1420px) {
        .brand img {
            height: 60px;
            width: auto;
            display: block;
        }

    }

    @media (max-width: 820px) {
        .brand img {
            height: 40px;
        }

        .top-nav {
            padding: 1rem clamp(1rem, 5vw, 2rem);
            gap: 1rem;
        }
    }

    @media (max-width: 640px) {
        .brand span {
            display: none;
        }

        .nav-links {
            gap: 0.5rem;
            justify-content: center;
            width: 100%;
        }

        .top-nav {
            flex-direction: column;
            align-items: center;
        }
    }
</style>

<nav class="top-nav">
    <a class="brand" href="/">
        <img src={logo.src} alt="Kiva School" loading="lazy" />
        <!-- <span>Kiva School</span> -->
    </a>
    <div class="nav-links">
        {
            navItems.map((item) =>
                item.type === "link" ? (
                    <NavLink link={item.href} text={item.label} />
                ) : (
                    <NavDropdown
                        baseLink={item.base}
                        label={item.label}
                        items={item.children.map((child) => ({
                            href: child.href,
                            text: child.label,
                        }))}
                    />
                ),
            )
        }
    </div>
</nav>
