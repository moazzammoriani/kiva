---
import NavLink from "./NavLink.astro";
import NavDropdown from "./NavDropdown.astro";
---

<style>
  nav {
    display: flex;
    margin: 0 auto;
    justify-content: space-evenly;
    padding: 40px 0px;
  }
</style>

<nav>
  <NavLink link="/" text="Home" />
  <NavDropdown
    baseLink="/about/"
    label="About Us"
    items={[
      { href: "/kiva/about/our-story/", text: "Our story" },
      { href: "/kiva/about/mission/", text: "Mission, Vision & Values" },
      { href: "/kiva/about/team/", text: "Meet the Team" },
    ]}
  />
  <NavLink link="/programmes/" text="Programmes" />
  <NavLink link="/admission/" text="Admission" />
  <NavLink link="/careers/" text="Kiva Square" />
  <NavLink link="/contact/" text="Contact Us" />
  <NavLink link="/community/" text="Community Enrichment" />
</nav>
