---
import NavLink from "./NavLink.astro";

type Item = { href: string; text: string };
const { baseLink, label, items } = Astro.props as {
    baseLink: string;
    label: string;
    items: Item[];
};

const rawBase = import.meta.env.BASE_URL || "/";
const trimmedBase = rawBase.replace(/\/$/, "");

const resolveHref = (href: string) => {
    const clean = href.startsWith("/") ? href : `/${href}`;
    if (trimmedBase === "") return clean;
    if (clean === "/") return `${trimmedBase}/`;
    return `${trimmedBase}${clean}`;
};

const resolvedLink = resolveHref(baseLink);

const normalize = (value: string) =>
    value.endsWith("/") ? value : `${value}/`;
const currentPath = normalize(Astro.url.pathname);
const activeLink = normalize(resolvedLink);
const baseNormalized = normalize(trimmedBase || "/");

const active =
    currentPath === activeLink ||
    (activeLink !== baseNormalized && currentPath.startsWith(activeLink));
---

<div class="nav-dropdown">
    <button class={`navspan ${active ? "active" : ""}`}>
        {label}
    </button>
    <ul class="menu" role="menu" aria-label={label}>
        {
            items.map((i) => (
                <li role="none">
                    <a
                        class="menu-link"
                        role="menuitem"
                        href={resolveHref(i.href)}
                    >
                        {i.text}
                    </a>
                </li>
            ))
        }
    </ul>

    <style>
        :root {
            --teal: #0db29b;
            --text: #214244;
            --border: #e8ecec;
            --menu-bg: #fcc27b;
            --menu-shadow:
                0 8px 20px rgba(0, 0, 0, 0.08), 0 2px 6px rgba(0, 0, 0, 0.04);
        }

        .navspan {
            border: none;
            background-color: white;
            display: inline-block;
            padding: 10px 20px;
            border-radius: 20px;
            text-decoration: none;
            color: var(--text);
            font-size: 0.95rem;
            white-space: nowrap;
            transition:
                background-color 120ms ease,
                color 120ms ease;
        }
        .navspan:focus,
        .navspan:hover {
            background: var(--teal);
            cursor: pointer;
            font-weight: 750;
        }

        .navspan.active {
            font-weight: 750;
            background: var(--teal);
        }
        .nav-dropdown {
            position: relative;
            display: inline-flex;
            align-items: center;
        }
        .nav-dropdown::after {
            content: "";
            position: absolute;
            top: 100%;
            left: 0;
            width: 100%;
            height: 12px;
            z-index: 10;
        }
        .menu {
            position: absolute;
            top: calc(100% + 6px);
            left: 50%;
            transform: translateX(-50%);
            display: none;
            list-style: none;
            margin: 0;
            padding: 0.4rem;
            min-width: 200px;
            background-color: var(--color-yellow);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: var(--menu-shadow);
            z-index: 60;
        }

        .nav-dropdown:hover .menu,
        .nav-dropdown:focus-within .menu {
            display: block;
        }

        .menu li {
            margin: 0;
        }
        .menu li:not(:last-child) {
            border-bottom: 2px solid var(--teal);
        }
        .menu-link {
            border-radius: 4px;
            display: block;
            padding: 0.6rem 0.9rem;
            text-decoration: none;
            color: var(--color-dark-blue);
            font-weight: 900;
            white-space: nowrap;
        }
        .menu-link:hover,
        .menu-link:focus {
            background: var(--teal);
            color: white;
            outline: none;
        }
    </style>
</div>
