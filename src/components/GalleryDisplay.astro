---
const { images } = Astro.props as {
    images: string[];
};
---

<div class="gallery">
    {
        images.map((imgSrc) => {
            const webp = imgSrc.replace(/\.(png|jpe?g)$/i, ".webp");
            return (
                <div>
                    <picture>
                        {webp !== imgSrc && <source srcset={webp} type="image/webp" />}
                        <img class="gallery--img" src={imgSrc} alt="" />
                    </picture>
                </div>
            );
        })
    }
</div>

<style>
    .gallery {
        display: flex;
        justify-content: space-between;
    }

    .gallery--img {
        width: 350px;
    }

    @media (max-width: 1176px) {
        .gallery--img {
            width: 300px;
        }
    }

    @media (max-width: 925px) {
        .gallery--img {
            width: 250px;
        }
    }

    @media (max-width: 842px) {
        .gallery--img {
            width: 220px;
        }
    }

    @media (max-width: 738px) {
        .gallery--img {
            width: 200px;
        }
    }
    @media (max-width: 676px) {
        .gallery {
            flex-direction: column;
            gap: 30px
        }

        .gallery--img {
            width: 80vw;;
        }
    }
