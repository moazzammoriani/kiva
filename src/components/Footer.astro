---
import "../styles/tokens.css";
import facebookIcon from "../assets/facebook-icon.png";
import instagramIcon from "../assets/instagram-icon.png";
import linkedinIcon from "../assets/linkedin-icon.png";
---

<style>
    footer {
        background-color: var(--color-yellow);
    }

    .footer-info {
        margin: 0 auto;
        max-width: 700px;
        padding: 2.5rem 1.5rem;
        color: var(--color-dark-blue);
        display: flex;
        justify-content: space-between;
    }
    .footer-copyright {
        background-color: #fe8866;
        color: white;
        display: flex;
        justify-content: space-evenly;
    }

    .footer-heading {
        font-weight: 800;
    }

    .footer__socials-icon {
        width: 20px;
    }

    .footer-link {
        font-weight: 600;
    }

    .footer-link a {
        color: inherit;
        text-decoration: none;
    }

    .footer-link a:hover,
    .footer-link a:focus-visible {
        color: var(--color-teal2);
    }
</style>

<footer>
    <div class="footer-info">
        <div>
            <p class="footer-heading"><strong>Get In Touch</strong></p>
            <p class="footer-link">32/E, PECHS, Block 6, Karachi</p>
            <p class="footer-link">0300 0605482</p>
            <p class="footer-link">info@kivaschool.com</p>
        </div>

        <div>
            <p class="footer-heading"><strong>Useful Links</strong></p>
            <p class="footer-link"><a href="/about/our-story/">Our Story</a></p>
            <p class="footer-link"><a href="/programmes/preschool-and-elementary/">Programmes</a></p>
            <p class="footer-link"><a href="/admission/process/">Admissions</a></p>
            <p class="footer-link"><a href="/careers/">Careers</a></p>
        </div>

        <div>
            <p class="footer-heading"><strong>Find us</strong></p>
            <a href=""
                ><img
                    class="footer__socials-icon"
                    src={facebookIcon.src}
                    alt=""
                /></a
            >
            <a href=""
                ><img
                    class="footer__socials-icon"
                    src={instagramIcon.src}
                    alt=""
                /></a
            >
            <a href=""
                ><img
                    class="footer__socials-icon"
                    src={linkedinIcon.src}
                    alt=""
                /></a
            >
        </div>
    </div>
    <div class="footer-copyright">
        <div>2025 Kiva School. All Rights Reserved.</div>
    </div>
</footer>
