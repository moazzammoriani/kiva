---
const {
    id,
    title,
    description,
    eyebrow,
    align = "center",
    variant = "plain",
    headingLevel = 2,
    className = "",
    contentWidth = "full",
} = Astro.props as {
    id?: string;
    title?: string;
    description?: string;
    eyebrow?: string;
    align?: "center" | "left";
    variant?: "plain" | "panel" | "accent";
    headingLevel?: 1 | 2 | 3 | 4 | 5 | 6;
    className?: string;
    contentWidth?: "full" | "narrow" | "tight";
};

const tag = `h${headingLevel}`;
const headingClass = `page-section__title_l${headingLevel}`;
const variantClass =
    variant === "panel"
        ? "page-section--panel"
        : variant === "accent"
          ? "page-section--accent"
          : "";

const classes = [
    "page-section",
    `page-section--align-${align}`,
    variantClass,
    className,
]
    .filter(Boolean)
    .join(" ");

const widthClass =
    contentWidth === "narrow"
        ? "page-section__body--narrow"
        : contentWidth === "tight"
          ? "page-section__body--tight"
          : "";
---

<section id={id} class={classes}>
    {
        (eyebrow || title || description) && (
            <div class={`page-section__header ${widthClass}`.trim()}>
                {eyebrow && <p class="page-section__eyebrow">{eyebrow}</p>}
                {title && (
                    <component
                        is={tag}
                        class={`page-section__title ${headingClass}`}
                    >
                        {title}
                    </component>
                )}
                {description && (
                    <p class="page-section__description">{description}</p>
                )}
            </div>
        )
    }
    <div class={`page-section__body ${widthClass}`.trim()}>
        <slot />
    </div>
</section>

<style>
    .page-section__header {
        font-weight: 1000;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        align-items: inherit;
        text-align: inherit;
    }

    .page-section__body > :where(:first-child) {
        margin-top: 0;
    }

    .page-section__title_l2 {
        font-size: 54px;
    }

    .page-section__title_l3 {
        font-size: 42px;
    }

    @media (max-width: 600px) {
        .page-section__title_l2 {
            font-size: 42px;
        }
        .page-section__title_l3 {
            font-size: 36px;
        }
    }
</style>
