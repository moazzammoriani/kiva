---
type Slide = {
    src: string;
    alt?: string;
    label?: string;
};

const { images = [] } = Astro.props as { images: Slide[] };
const initial = images[0] ?? { src: "", alt: "", label: "" };

import sunflower from "../assets/sunflower.png";
import frame from "../assets/slideshow-frame.png";
import "../styles/tokens.css";
import "../styles/global.css";
import leftBtn from "../assets/left_slideshow_button.png";
import rightBtn from "../assets/right_slideshow_button.png";
---

<!-- TODO: make the flowers bigger  --><!-- TODO: decrease the button size --><!-- TODO: use proper fonts for the slideshow label -->
<figure class="slideshow" data-length={images.length}>
    <button
        class="slideshow__button slideshow__button--left"
        type="button"
        data-action="prev"
        aria-label="Previous slide"
    >
        <img src={leftBtn.src} alt="" class="slideshow__button-img" />
    </button>

    <div class="slideshow__viewport">
        <img
            src={initial.src}
            alt={initial.alt ?? ""}
            class="slideshow__image"
        />
        <img src={frame.src} alt="" class="slideshow__frame" />
    </div>

    <button
        class="slideshow__button slideshow__button--right"
        type="button"
        data-action="next"
        aria-label="Next slide"
    >
        <img src={rightBtn.src} alt="" class="slideshow__button-img" />
    </button>
</figure>
<div class="slideshow__caption">{initial.label}</div>

<script type="module" define:vars={{ clientImages: images }}>
    const script = document.currentScript;
    const images = clientImages;
    const container = document.querySelector(".slideshow");
    if (!container || !images.length) {
        script.remove();
    }

    let index = 0;
    const imageEl = container.querySelector(".slideshow__image");
    const captionEl = document.querySelector(".slideshow__caption");
    const buttons = container.querySelectorAll(".slideshow__button");

    const update = () => {
        const slide = images[index];
        if (!slide) return;
        if (imageEl) {
            imageEl.src = slide.src;
            imageEl.alt = slide.alt ?? "";
        }
        console.log(slide.label);
        if (captionEl) captionEl.textContent = slide.label;
    };

    buttons.forEach((button) => {
        button.addEventListener("click", () => {
            if (button.dataset.action === "prev") {
                index = (index - 1 + images.length) % images.length;
            } else {
                index = (index + 1) % images.length;
            }
            update();
        });
    });
    update();
</script>

<style>
    .slideshow {
        width: 100%;
        max-width: 720px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 0.75rem;
        align-items: center;
    }

    .slideshow__viewport {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background: #f5d07c;
    }

    .slideshow__image {
        position: absolute;
        inset: 0;
        /* top: 0; */
        /* left: 0; */
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .slideshow__frame {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        pointer-events: none;
        z-index: 2;
    }

    .slideshow__caption {
        font-family: "Nunito", sans-serif;
        color: var(--color-teal);
        text-align: center;
        font-weight: 800;
        font-size: 40px;
        padding: 30px;
    }

    .slideshow__button {
        width: 54px;
        height: 54px;
        border-radius: 50%;
        border: none;
        background: var(--color-teal, #0db29b);
        color: var(--color-dark-blue);
        font-size: 1.5rem;
        line-height: 1;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: transform 140ms ease, background 140ms ease;
    }

    .slideshow__button:hover {
        background: var(--color-deep-teal, #05897a);
        transform: translateY(-2px);
    }

    .slideshow__button-img {
        width: 28px;
        height: 28px;
    }

    @media (max-width: 600px) {
        .slideshow__viewport {
            padding-top: 75%;
        }
    }

    /* Responsive simplification at ~786px and below */
    @media (max-width: 786px) {
        .slideshow {
            grid-template-columns: auto 1fr auto;
            gap: 0.5rem;
        }

        .slideshow__viewport {
            aspect-ratio: 1 / 1;
            padding-top: 0;
        }

        .slideshow__button {
            width: 44px;
            height: 44px;
            background: white;
            border: 2px solid var(--color-teal);
        }

        .slideshow__button-img {
            filter: invert(35%) sepia(98%) saturate(405%) hue-rotate(121deg)
                brightness(92%) contrast(88%);
        }

        .slideshow__caption {
            font-size: 1.4rem;
        }
    }
</style>
