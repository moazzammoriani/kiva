---
import TeamMemberCard from "./TeamMemberCard.astro";
import PageSection from "./PageSection.astro";

type Member = {
  name: string;
  bio: string;
  photoLabel?: string;
};

const { title, members } = Astro.props as {
  title: string;
  members: Member[];
};
---

<PageSection title={title}>
  <div class="stack-lg">
    {members.map((member) => (
      <TeamMemberCard {...member} />
    ))}
  </div>
</PageSection>
