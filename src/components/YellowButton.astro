---
const { text, link = '/admission/form/' } = Astro.props;
import "../styles/tokens.css";
import "../styles/global.css";
---

<div class="yellow-btn-container">
    <a href={link} class="yellow-btn">{text}</a>
</div>

<style>
    .yellow-btn-container {
        text-align: center;
    }
    .yellow-btn {
        font-family: "Nunito", sans-serif;
        font-weight: 900;
        font-size: 22px;
        background-color: var(--color-yellow);
        color: var(--color-dark-blue);
        border: none;
        min-width: 160px;
        padding: 10px 20px;
        height: 50px;
        border-radius: 12px;
        text-decoration: none;
    }

    .yellow-btn:hover {
        cursor: pointer;
    }
</style>
