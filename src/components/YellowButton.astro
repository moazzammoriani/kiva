---
const { text } = Astro.props;
import "../styles/tokens.css";
import "../styles/global.css";
---

<div class="yellow-btn-container">
  <button class="yellow-btn">{text}</button>
</div>

<style>
  .yellow-btn-container {
    text-align: center;
  }
  .yellow-btn {
    font-family: "Nunito", sans-serif;
    font-weight: 900;
    font-size: 22px;
    background-color: var(--color-yellow);
    color: var(--color-dark-blue);
    border: none;
    width: 160px;
    height: 50px;
    border-radius: 12px;
  }
</style>
