---
const { name, bio, color, imgSrc } = Astro.props as {
    name: string;
    bio: string;
    imgSrc: string;
    color: string;
};

import yellowRibbon from "../assets/name-ribbon-yellow.png";
import blueRibbon from "../assets/name-ribbon-blue.png";
---

<!-- TODO: make the card as wide as the faq thing -->
<article
    class=`member-card ${color === 'yellow' ? 'yellow-member-card' : 'blue-member-card'}`
    role="group"
    aria-label={`${name} profile`}
>
    <div class="member-photo" role="img">
        <img src={imgSrc} alt="" />
        <h3
            class={color === "yellow"
                ? "yellow-card-ribbon"
                : "blue-card-ribbon"}
        >
            {name}
        </h3>
    </div>
    <div class="member-content">
        <h2>{}</h2>
        <p>{bio}</p>
    </div>
</article>

<style
    define:vars={{
        yellowRibbonUrl: `url(${yellowRibbon.src})`,
        blueRibbonUrl: `url(${blueRibbon.src})`,
    }}
>
    .yellow-member-card {
        background: var(--color-warm-yellow);
    }
    .blue-member-card {
        background: var(--color-teal);
    }

    .member-card {
        border-radius: 28px;
        padding: 1.75rem;
        display: grid;
        grid-template-columns: minmax(140px, 250px) 1fr;
        gap: 1.5rem;
        align-items: center;
        color: #214244;
        /* max-width: 760px; */
        margin: 0 auto;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.1);
    }

    .member-photo {
        /* width: 100%; */
        /* height: 200px; */
        /* background: var(--color-accent-orange); */
        border-radius: 20px;
    }

    .member-photo img {
        height: 250px;
    }

    .member-content h3 {
        margin: 0 0 0.65rem;
        font-size: 1.35rem;
        letter-spacing: 0.4px;
    }

    .yellow-card-ribbon {
        background-image: var(--yellowRibbonUrl);
        background-size: 250px;
        width: 250px;
        height: 50px;
        background-position: center;
        background-repeat: no-repeat;
        line-height: 50px;
    }

    .blue-card-ribbon {
        background-image: var(--blueRibbonUrl);
        background-size: 250px;
        width: 250px;
        height: 50px;
        background-position: center;
        background-repeat: no-repeat;
        line-height: 50px;
    }

    .member-content p {
        margin: 0;
        line-height: 1.7;
        font-size: 1rem;
    }

    @media (max-width: 720px) {
        .member-card {
            grid-template-columns: 1fr;
            text-align: center;
            padding: 1.5rem;
        }

        .member-photo {
            height: 220px;
            margin: 0 auto;
        }
    }
</style>
