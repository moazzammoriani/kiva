---
const { name, bio, photoLabel } = Astro.props as {
  name: string;
  bio: string;
  photoLabel?: string;
};
---

<article class="member-card" role="group" aria-label={`${name} profile`}>
  <div class="member-photo" role="img" aria-label={photoLabel ?? `${name} portrait placeholder`}></div>
  <div class="member-content">
    <h3>{name}</h3>
    <p>{bio}</p>
  </div>
</article>

<style>
  .member-card {
    background: var(--color-warm-yellow);
    border-radius: 28px;
    padding: 1.75rem;
    display: grid;
    grid-template-columns: minmax(140px, 200px) 1fr;
    gap: 1.5rem;
    align-items: center;
    color: #214244;
    max-width: 760px;
    margin: 0 auto;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.1);
  }

  .member-photo {
    width: 100%;
    height: 200px;
    background: var(--color-accent-orange);
    border-radius: 20px;
  }

  .member-content h3 {
    margin: 0 0 0.65rem;
    font-size: 1.35rem;
    letter-spacing: 0.4px;
  }

  .member-content p {
    margin: 0;
    line-height: 1.7;
    font-size: 1rem;
  }

  @media (max-width: 720px) {
    .member-card {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 1.5rem;
    }

    .member-photo {
      height: 220px;
      margin: 0 auto;
    }
  }
</style>
