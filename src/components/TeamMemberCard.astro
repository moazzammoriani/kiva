---
const { name, bio, color, imgSrc } = Astro.props as {
    name: string;
    bio: string;
    imgSrc: string;
    color: string;
};

const imgWebP = imgSrc.replace(/\.(png|jpe?g)$/i, ".webp");

import yellowRibbon from "../assets/name-ribbon-yellow.webp";
import blueRibbon from "../assets/name-ribbon-blue.webp";
---

<!-- TODO: make the card as wide as the faq thing -->
<article
    class=`member-card ${color === 'yellow' ? 'yellow-member-card' : 'blue-member-card'}`
    role="group"
    aria-label={`${name} profile`}
>
    <div class="member-photo" role="img">
        <picture>
            {imgWebP !== imgSrc && <source srcset={imgWebP} type="image/webp" />}
            <img src={imgSrc} alt="" />
        </picture>
        <h3
            class={color === "yellow"
                ? "yellow-card-ribbon"
                : "blue-card-ribbon"}
        >
            {name}
        </h3>
    </div>
    <div class="member-content">
        <p set:html={bio} />

        <style
            define:vars={{
                yellowRibbonUrl: `url(${yellowRibbon.src})`,
                blueRibbonUrl: `url(${blueRibbon.src})`,
            }}
        >
            .yellow-member-card {
                background: var(--color-yellow);
            }
            .blue-member-card {
                background: var(--color-teal);
            }

            .member-card {
                border-radius: 28px;
                padding: 1.75rem;
                display: grid;
                grid-template-columns: minmax(140px, 250px) 1fr;
                gap: 1.5rem;
                align-items: stretch;
                color: #000000;
                max-width: var(--layout-max-width);
                margin: 0 auto;
                box-shadow: 0 16px 40px rgba(0, 0, 0, 0.1);
            }

            .member-photo {
                border-radius: 20px;
                margin-top: 24px;
            }

            .member-photo img {
                height: 250px;
            }

            .member-content h3 {
                margin: 0 0 0.65rem;
                font-size: 1.35rem;
                letter-spacing: 0.4px;
            }

            .member-content {
                text-align: left;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .yellow-card-ribbon {
                background-image: var(--yellowRibbonUrl);
                background-size: 250px;
                width: 250px;
                height: 50px;
                background-position: center;
                background-repeat: no-repeat;
                line-height: 50px;
            }

            .blue-card-ribbon {
                background-image: var(--blueRibbonUrl);
                background-size: 250px;
                width: 250px;
                height: 50px;
                background-position: center;
                background-repeat: no-repeat;
                line-height: 50px;
            }

            .member-content p {
                margin: 0;
                line-height: 1.7;
                font-size: 1rem;
            }

            @media (max-width: 720px) {
                .member-card {
                    grid-template-columns: 1fr;
                    text-align: center;
                    padding: 2rem;
                }

                .member-photo {
                    height: 280px;
                    margin: 0 auto;
                    margin-bottom: 40px;
                }
            }
        </style>
    </div>
</article>
