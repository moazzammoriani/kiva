---
interface AgeGroup {
    name?: string;
    ageRange?: string;
}

const { ageGroups = [] } = Astro.props as { ageGroups?: AgeGroup[] };

const defaultGroups: AgeGroup[] = [
    { name: "Playgroup", ageRange: "Age 1.5 to 2.5" },
    { name: "Pre-Nursery", ageRange: "Age 2.5 to 3.5" },
    { name: "Nursery", ageRange: "Age 3.5 – 4.5" },
    { name: "Prep", ageRange: "Age 4.5 – 5.5" },
];

const groups = ageGroups.length > 0 ? ageGroups : defaultGroups;

// Split into pairs of 2 for the 2-column layout (left pair, right pair per row)
const half = Math.ceil(groups.length / 2);
const leftColumn = groups.slice(0, half);
const rightColumn = groups.slice(half);
const rowCount = Math.max(leftColumn.length, rightColumn.length);
---

<div>
    <table class="age-table">
        {Array.from({ length: rowCount }).map((_, i) => (
            <tr>
                {leftColumn[i] ? (
                    <>
                        <th>{leftColumn[i].name}</th>
                        <td>{leftColumn[i].ageRange}</td>
                    </>
                ) : (
                    <>
                        <th></th>
                        <td></td>
                    </>
                )}
                {rightColumn[i] ? (
                    <>
                        <th>{rightColumn[i].name}</th>
                        <td>{rightColumn[i].ageRange}</td>
                    </>
                ) : (
                    <>
                        <th></th>
                        <td></td>
                    </>
                )}
            </tr>
        ))}
    </table>
</div>

<style>
    .age-table {
        border: 3px solid #f4c430; /* warm yellow */
        border-radius: 16px;
        border-collapse: separate;
        border-spacing: 0;
        font-family: sans-serif;
        text-align: center;
        color: #00a99d; /* teal text */
        margin: 0 auto;
    }

    .age-table th,
    .age-table td {
        border: 1.5px solid #f4c430;
        padding: 1rem 1.25rem;
    }

    .age-table th {
        font-weight: 700;
    }

    .age-table tr:first-child th:first-child {
        border-top-left-radius: 16px;
    }
    .age-table tr:first-child td:last-child {
        border-top-right-radius: 16px;
    }
    .age-table tr:last-child th:first-child {
        border-bottom-left-radius: 16px;
    }
    .age-table tr:last-child td:last-child {
        border-bottom-right-radius: 16px;
    }

    @media (max-width: 573px) {
        .age-table th,
        .age-table td {
            padding: 20px 8px;
        }
    }

    @media (max-width: 460px) {
        .age-table th,
        .age-table td {
            font-size: 14px;
        }
    }

    @media (max-width: 426px) {
        .age-table th,
        .age-table td {
            font-size: 13px;
        }
    }


    @media (max-width: 392px) {
        .age-table th,
        .age-table td {
            font-size: 12px;
        }
    }

    @media (max-width: 392px) {
        .age-table th,
        .age-table td {
            padding: 20px 6px;
        }
    }
</style>
