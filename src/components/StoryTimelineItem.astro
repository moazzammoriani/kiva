---
import StoryYear from "./StoryYear.astro";
import StoryDescription from "./StoryDescription.astro";

const { year } = Astro.props as { year: string };
---

<div class="timeline-item">
  <StoryYear value={year} />
  <div class="connector" aria-hidden="true"></div>
  <StoryDescription>
    <slot />
  </StoryDescription>
</div>

<style>
  .timeline-item {
    display: grid;
    grid-template-columns: minmax(120px, 160px) 60px 1fr;
    align-items: center;
    gap: 1.25rem;
  }

  .connector {
    width: 100%;
    height: 12px;
    background: radial-gradient(circle at center, #f6c65b 0%, #f6c65b 40%, transparent 42%),
      radial-gradient(circle at center, #f6c65b 0%, #f6c65b 40%, transparent 42%);
    background-position: top center, bottom center;
    background-repeat: no-repeat;
    background-size: 60% 6px;
  }

  @media (max-width: 720px) {
    .timeline-item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .connector {
      display: none;
    }
  }
</style>
