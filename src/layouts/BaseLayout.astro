---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import defaultHero from "../assets/high-angle-child-woman-painting.jpg";

const {
  pageTitle = null,
  heroSrc = defaultHero.src,
  heroAlt = "Children exploring paint materials at Kiva School",
} = Astro.props as {
  pageTitle?: string | null;
  heroSrc?: string | null;
  heroAlt?: string;
};

const documentTitle = pageTitle ? `${pageTitle} · Kiva School` : "Kiva School";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{documentTitle}</title>
  </head>
  <body>
    <div class="wrapper">
      <Navigation />
      {heroSrc && (
        <div class="banner" role="presentation">
          <img src={heroSrc} alt={heroAlt} loading="eager" />
        </div>
      )}
      <main class="page-content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
